<script src="/js/content-index.js?v=20260825-1"></script>
<script>
  (() => {
    const contentIndex = window.__SITE_CONTENT_INDEX__ || { entries: [], groups: [] };
    const languageNames = {
      EN: "English",
      ZH: "中文",
      JA: "日本語"
    };
    const languageLabels = {
      EN: "Article language: English",
      ZH: "文章语言：中文",
      JA: "記事の言語：日本語"
    };

    const normalizePath = value => {
      try {
        return new URL(value, window.location.origin).pathname;
      } catch (error) {
        return String(value || "");
      }
    };

    const normalizeLanguage = value => {
      const language = String(value || "").toLowerCase();
      if (language.startsWith("en")) return "EN";
      if (language.startsWith("ja")) return "JA";
      return "ZH";
    };

    const entryByPath = new Map(
      contentIndex.entries.map(entry => [normalizePath(entry.path), entry])
    );
    const groupByKey = new Map(
      contentIndex.groups.map(group => [group.key, group])
    );

    const getPostPath = post => {
      const link = post.querySelector(".post-title-link");
      if (link) return normalizePath(link.getAttribute("href"));
      return normalizePath(window.location.pathname);
    };

    document.querySelectorAll(".post-block").forEach(post => {
      const meta = post.querySelector(".post-meta-container");
      if (!meta || meta.querySelector(".portfolio-lang-tag")) return;

      const article = post.querySelector(".post-content");
      const marker = post.querySelector("[data-article-language]");
      const entry = entryByPath.get(getPostPath(post));
      const language = normalizeLanguage(
        article?.getAttribute("lang") || marker?.dataset.articleLanguage || entry?.langCode
      );
      const tag = document.createElement("span");
      tag.className = "portfolio-lang-tag";
      tag.textContent = language;
      tag.setAttribute("aria-label", languageLabels[language]);
      meta.appendChild(tag);
    });

    const essaysMain = window.location.pathname.startsWith("/essays/")
      ? document.querySelector(".main-inner.index.posts-expand")
      : null;

    if (essaysMain) {
      document.body.classList.add("portfolio-essays-page");

      const pageHeader = document.createElement("header");
      pageHeader.className = "portfolio-essays-header";

      const eyebrow = document.createElement("p");
      eyebrow.className = "research-eyebrow";
      eyebrow.textContent = "Research archive";

      const title = document.createElement("h1");
      title.textContent = "Essays";

      const intro = document.createElement("p");
      intro.textContent = "Long-form research on political economy, financial markets, technology, and institutional change in China and Japan.";

      const filters = document.createElement("div");
      filters.className = "portfolio-essay-filters";
      filters.setAttribute("aria-label", "Filter essays");

      const createFilter = (name, values) => {
        const group = document.createElement("div");
        group.className = "portfolio-filter-group";
        group.dataset.filterGroup = name.toLowerCase();

        const label = document.createElement("span");
        label.className = "portfolio-filter-label";
        label.textContent = name;
        group.appendChild(label);

        values.forEach((value, index) => {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "portfolio-filter-button";
          button.dataset.filterValue = value.value;
          button.textContent = value.label;
          button.setAttribute("aria-pressed", String(index === 0));
          if (index === 0) button.classList.add("is-active");
          group.appendChild(button);
        });

        return group;
      };

      filters.append(
        createFilter("Topic", [
          { value: "all", label: "All" },
          { value: "markets", label: "Money & Markets" },
          { value: "ai", label: "AI & Industry" },
          { value: "japan", label: "Japan" }
        ]),
        createFilter("Language", [
          { value: "all", label: "All" },
          { value: "EN", label: "EN" },
          { value: "ZH", label: "中文" },
          { value: "JA", label: "日本語" }
        ])
      );

      const status = document.createElement("p");
      status.className = "portfolio-essay-status";
      status.setAttribute("aria-live", "polite");

      pageHeader.append(eyebrow, title, intro, filters, status);
      essaysMain.insertBefore(pageHeader, essaysMain.firstChild);

      const topicValue = category => {
        if (category === "Money & Markets") return "markets";
        if (category === "AI & Industry") return "ai";
        if (category === "Japan") return "japan";
        return "other";
      };

      const cards = Array.from(essaysMain.querySelectorAll(".post-block"));

      const renderCardLanguage = (card, selectedLanguage) => {
        const state = card.__portfolioTranslationState;
        if (!state) return;

        const selectedLanguageEntry = selectedLanguage === "all"
          ? null
          : state.group?.languages
              ?.find(language => language.code === selectedLanguage);
        const selectedEntry = selectedLanguageEntry
          ? entryByPath.get(normalizePath(selectedLanguageEntry.path))
          : state.defaultEntry;
        const selectedPath = selectedEntry?.path || state.defaultPath;
        const selectedCode = selectedEntry?.langCode || state.defaultLanguage;
        const selectedTitle = selectedCode === "ZH" && state.group?.cardTitle
          ? state.group.cardTitle
          : (selectedEntry?.title || state.defaultTitle);
        const selectedDescription = selectedEntry?.description || state.defaultDescription;

        if (state.titleLink) {
          state.titleLink.href = selectedPath;
          state.titleLink.textContent = selectedTitle;
        }
        if (state.readMoreLink) state.readMoreLink.href = selectedPath;
        if (state.descriptionNode) state.descriptionNode.textContent = selectedDescription;
        if (state.languageTag) {
          state.languageTag.textContent = selectedCode;
          state.languageTag.setAttribute("aria-label", languageLabels[selectedCode]);
        }
        if (state.postContent) {
          state.postContent.lang = selectedCode === "EN" ? "en" : selectedCode === "JA" ? "ja" : "zh";
          state.postContent.querySelector('[itemprop="mainEntityOfPage"]')?.setAttribute("href", selectedPath);
        }
        state.translationLinks?.querySelectorAll("a").forEach(link => {
          const isCurrent = normalizePath(link.getAttribute("href")) === normalizePath(selectedPath);
          if (isCurrent) link.setAttribute("aria-current", "page");
          else link.removeAttribute("aria-current");
        });
      };

      cards.forEach(card => {
        const path = getPostPath(card);
        const entry = entryByPath.get(path);
        const group = entry ? groupByKey.get(entry.translationKey) : null;
        const defaultEntry = group
          ? entryByPath.get(normalizePath(group.primaryPath)) || entry
          : entry;
        const languages = group?.languages || [{
          code: normalizeLanguage(card.querySelector(".post-content")?.getAttribute("lang")),
          path
        }];

        card.dataset.topic = topicValue(group?.category || entry?.category || "");
        card.dataset.languages = languages.map(language => language.code).join(",");

        card.__portfolioTranslationState = {
          group,
          defaultEntry,
          defaultPath: group?.primaryPath || path,
          defaultTitle: group?.cardTitle || defaultEntry?.title || card.querySelector(".post-title-link")?.textContent.trim() || "",
          defaultDescription: defaultEntry?.description || card.querySelector(".post-body > p")?.textContent.trim() || "",
          defaultLanguage: defaultEntry?.langCode || normalizeLanguage(card.querySelector(".post-content")?.getAttribute("lang")),
          titleLink: card.querySelector(".post-title-link"),
          descriptionNode: card.querySelector(".post-body > p"),
          readMoreLink: card.querySelector(".post-button .btn"),
          languageTag: card.querySelector(".portfolio-lang-tag"),
          postContent: card.querySelector(".post-content"),
          translationLinks: null
        };

        if (group && group.languages.length >= 2) {
          const translationLinks = document.createElement("nav");
          translationLinks.className = "portfolio-translation-links";
          translationLinks.setAttribute("aria-label", "Available translations");

          const translationLabel = document.createElement("span");
          translationLabel.textContent = "Read in";
          translationLinks.appendChild(translationLabel);

          group.languages.forEach(language => {
            const link = document.createElement("a");
            link.href = language.path;
            link.textContent = languageNames[language.code];
            translationLinks.appendChild(link);
          });

          card.__portfolioTranslationState.translationLinks = translationLinks;
          card.querySelector(".post-header")?.appendChild(translationLinks);
        }

        renderCardLanguage(card, "all");
      });

      const activeValue = groupName => {
        return filters.querySelector(
          '[data-filter-group="' + groupName + '"] .portfolio-filter-button.is-active'
        )?.dataset.filterValue || "all";
      };

      const applyFilters = () => {
        const selectedTopic = activeValue("topic");
        const selectedLanguage = activeValue("language");
        let visibleCount = 0;

        cards.forEach(card => {
          const topicMatches = selectedTopic === "all" || card.dataset.topic === selectedTopic;
          const languages = String(card.dataset.languages || "").split(",");
          const languageMatches = selectedLanguage === "all" || languages.includes(selectedLanguage);
          const visible = topicMatches && languageMatches;
          renderCardLanguage(card, selectedLanguage);
          card.hidden = !visible;
          if (visible) visibleCount += 1;
        });

        status.textContent = visibleCount + (visibleCount === 1 ? " essay" : " essays");
      };

      filters.querySelectorAll(".portfolio-filter-button").forEach(button => {
        button.addEventListener("click", () => {
          const group = button.closest(".portfolio-filter-group");
          group.querySelectorAll(".portfolio-filter-button").forEach(option => {
            const active = option === button;
            option.classList.toggle("is-active", active);
            option.setAttribute("aria-pressed", String(active));
          });
          applyFilters();
        });
      });

      applyFilters();
    }

    const latestList = document.getElementById("research-latest-list");
    if (latestList) {
      const latestGroups = contentIndex.groups
        .filter(group => group.category !== "Notes")
        .slice(0, 3);

      latestGroups.forEach(group => {
        const row = document.createElement("article");
        row.className = "research-latest-row";

        const meta = document.createElement("div");
        meta.className = "research-latest-meta";
        const date = document.createElement("time");
        date.dateTime = group.date;
        date.textContent = group.date;
        const detail = document.createElement("span");
        detail.textContent = group.category;
        meta.append(date, detail);

        if (group.languages.length > 1) {
          const languageLinks = document.createElement("nav");
          languageLinks.className = "research-latest-language-links";
          languageLinks.setAttribute("aria-label", "Available editions");
          group.languages.forEach(language => {
            const languageLink = document.createElement("a");
            languageLink.href = language.path;
            languageLink.textContent = languageNames[language.code];
            languageLinks.appendChild(languageLink);
          });
          meta.appendChild(languageLinks);
        } else {
          detail.textContent += " · " + group.languages[0].code;
        }

        const heading = document.createElement("h3");
        const titleLink = document.createElement("a");
        titleLink.href = group.primaryPath;
        titleLink.textContent = group.title;
        heading.appendChild(titleLink);

        const description = document.createElement("p");
        description.textContent = group.description;

        const readLink = document.createElement("a");
        readLink.className = "research-arrow-link";
        readLink.href = group.primaryPath;
        readLink.append("Read article ");
        const icon = document.createElement("i");
        icon.className = "fa fa-arrow-right";
        icon.setAttribute("aria-hidden", "true");
        readLink.appendChild(icon);

        row.append(meta, heading, description, readLink);
        latestList.appendChild(row);
      });
    }

    const postArticle = document.querySelector(
      ".main-inner:not(.index) .post-block .post-content"
    );
    const desktopTocLinks = document.querySelectorAll(".post-toc .nav-link");
    if (postArticle && desktopTocLinks.length) {
      const details = document.createElement("details");
      details.className = "mobile-article-toc";

      const summary = document.createElement("summary");
      summary.textContent = "On this page";

      const list = document.createElement("ol");
      desktopTocLinks.forEach(tocLink => {
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = tocLink.getAttribute("href");
        link.textContent = tocLink.textContent.trim();
        link.addEventListener("click", () => {
          details.open = false;
        });
        item.appendChild(link);
        list.appendChild(item);
      });

      details.append(summary, list);
      const postBody = postArticle.querySelector(".post-body");
      if (postBody) postArticle.insertBefore(details, postBody);
    }
  })();

  (() => {
    const comments = document.querySelector(".comments.utterances-container");
    if (!comments || comments.closest(".portfolio-discussion")) return;

    const discussion = document.createElement("section");
    discussion.className = "portfolio-discussion";
    discussion.setAttribute("aria-labelledby", "portfolio-discussion-title");

    const header = document.createElement("header");
    header.className = "portfolio-discussion-header";

    const title = document.createElement("h2");
    title.id = "portfolio-discussion-title";
    title.className = "portfolio-discussion-title";
    title.append("Discussion ");

    const divider = document.createElement("span");
    divider.setAttribute("aria-hidden", "true");
    divider.textContent = "/";
    title.append(divider, " ");

    const chineseTitle = document.createElement("span");
    chineseTitle.lang = "zh";
    chineseTitle.textContent = "讨论";
    title.appendChild(chineseTitle);

    const note = document.createElement("p");
    note.className = "portfolio-discussion-note";
    note.append("Thoughts, corrections, and counterarguments are welcome. ");

    const chineseNote = document.createElement("span");
    chineseNote.lang = "zh";
    chineseNote.textContent = "使用 GitHub 登录后即可留言。";
    note.appendChild(chineseNote);

    header.append(title, note);
    discussion.appendChild(header);
    comments.parentNode.insertBefore(discussion, comments);
    discussion.appendChild(comments);
  })();

  (() => {
    const button = document.querySelector(".research-menu-button");
    const navigation = document.querySelector(".research-mobile-nav");
    if (!button || !navigation) return;

    const setOpen = open => {
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
      button.classList.toggle("is-open", open);
      navigation.classList.toggle("is-open", open);
    };

    button.addEventListener("click", () => {
      setOpen(button.getAttribute("aria-expanded") !== "true");
    });

    navigation.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", event => {
      if (event.key === "Escape") setOpen(false);
    });
  })();
</script>
