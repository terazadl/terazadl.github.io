}

.weekly-issue-card.is-japan {
  border-top: 4px solid var(--weekly-japan);
}

.weekly-issue-header {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 14px;
  flex-wrap: wrap;
  gap: 8px;
}

.weekly-issue-badge-group {
  align-items: center;
  display: flex;
  gap: 8px;
}

.weekly-issue-num {
  border-radius: 4px;
  font-family: var(--research-sans);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
