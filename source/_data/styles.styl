}

.weekly-issue-lang-links a:hover {
  background: rgba(47, 85, 212, 0.14);
}

.weekly-scope-card {
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid var(--weekly-card-border);
  border-radius: 8px;
  padding: 24px;
