    gap: 14px;
  }

  .research-brand-name {
    font-size: 29px;
  }

  .research-brand-divider {
    height: 31px;
  }

  .research-brand-field {
    font-size: 13px;
  }

  .research-desktop-nav,
  .research-github-link {
    display: none;
  }

  .research-menu-button {
    align-items: center;
    background: transparent;
    border: 1px solid var(--research-line);
    display: inline-flex;
    flex-direction: column;
    gap: 5px;
    height: 44px;
    justify-content: center;
    margin-left: auto;
    padding: 0;
    width: 44px;
  }

  .research-menu-button span {
    background: var(--research-ink);
    display: block;
    height: 1px;
    transition: transform .16s ease, opacity .16s ease;
    width: 20px;
  }

  .research-menu-button.is-open span:first-child {
    transform: translateY(6px) rotate(45deg);
  }

  .research-menu-button.is-open span:nth-child(2) {
    opacity: 0;
  }

  .research-menu-button.is-open span:last-child {
    transform: translateY(-6px) rotate(-45deg);
  }

  .research-mobile-nav {
    background: var(--research-paper);
    border-bottom: 1px solid transparent;
    display: grid;
    left: 0;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    position: absolute;
    right: 0;
    top: calc(100% + 1px);
    transition: max-height .2s ease, opacity .18s ease, border-color .18s ease;
  }

  .research-mobile-nav.is-open {
    border-bottom-color: var(--research-ink);
    max-height: 360px;
    opacity: 1;
  }

  .research-mobile-nav a {
    align-items: center;
    border: 0;
    border-bottom: 1px solid rgba(168, 160, 146, .48);
    display: flex;
    font-size: 17px;
    font-weight: 700;
    justify-content: space-between;
    margin: 0 4px;
    min-height: 50px;
    text-decoration: none;
  }

  .research-hero-grid {
    grid-template-columns: 1fr;
    padding-top: 46px;
  }

  .research-hero-intro {
    min-height: 530px;
    padding-right: 0;
  }

  .research-featured {
    border-left: 0;
    border-top: 1px solid var(--research-line);
    margin-top: 52px;
    padding: 50px 0 0;
  }

  .research-latest {
    margin-top: 28px;
  }

  .research-latest-row {
    grid-template-columns: 150px 1fr auto;
  }

  .research-latest-row > p {
    grid-column: 2 / -1;
  }

  .research-profile-strip {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .research-profile-item:nth-child(3) {
    border-left: 0;
    border-top: 1px solid var(--research-line);
  }

  .research-profile-item:nth-child(4) {
    border-top: 1px solid var(--research-line);
  }
}

@media (max-width: 650px) {
  header.header,
  .portfolio-home-page .main-inner,
  .footer {
    padding-left: 20px;
    padding-right: 20px;
  }

  .research-brand-field,
  .research-brand-divider {
    display: none;
  }

  .research-hero-intro {
    min-height: 0;
  }

  .research-hero-intro h1 {
    font-size: clamp(44px, 13vw, 58px);
  }

  .research-hero-intro > p {
    font-size: 18px;
    margin-top: 26px;
  }

  .research-hero-actions {
    align-items: flex-start;
    flex-direction: column;
    gap: 14px;
    margin-top: 36px;
  }

  .research-primary-button {
    width: 100%;
  }

  .research-featured {
    margin-top: 44px;
  }

  .research-featured h2 {
    font-size: 42px;
  }

  .research-featured-body {
    gap: 38px;
    grid-template-columns: 1fr;
    margin-top: 34px;
  }

  .research-chart {
    border-top: 1px solid var(--research-line);
    padding-top: 28px;
  }

  .research-chart figcaption {
    align-items: flex-start;
    flex-direction: column;
    gap: 5px;
  }

  .research-chart img {
    height: auto;
    margin-top: 12px;
  }

  .research-featured-actions {
    flex-direction: column;
    gap: 10px;
  }

  .research-latest {
    margin-top: 40px;
  }

  .research-latest-row {
    gap: 20px;
    grid-template-columns: 1fr;
  }

  .research-latest h3 {
    border-left: 0;
    border-top: 1px solid var(--research-line);
    font-size: 24px;
    padding: 20px 0 0;
  }

  .research-latest-row > p {
    grid-column: auto;
  }

  .research-profile-strip {
    grid-template-columns: 1fr;
  }

  .research-profile-item,
  .research-profile-item + .research-profile-item {
    border-left: 0;
    border-top: 1px solid var(--research-line);
    padding: 22px 4px;
  }

  .research-profile-item:first-child {
    border-top: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: .001ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: .001ms !important;
  }
}

