  align-items: center;
  gap: 12px;
}

.life-stream-avatar {
  align-items: center;
  background: var(--portfolio-ink);
  border-radius: 50%;
  color: var(--portfolio-paper);
  display: flex;
  font-family: var(--research-sans);
  font-size: 12px;
  font-weight: 700;
  height: 32px;
  justify-content: center;
