}

.research-topic-card {
  background: var(--weekly-card-bg, #ffffff);
  border: 1px solid var(--weekly-card-border, rgba(29, 28, 24, 0.08));
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  padding: 22px 24px;
  text-decoration: none !important;
  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  position: relative;
}

.research-topic-card:hover {
  transform: translateY(-3px);
  border-color: var(--research-blue, #2f55d4);
  box-shadow: 0 6px 18px rgba(29, 28, 24, 0.06);
}

.research-topic-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}

.research-topic-hub-number {
  color: var(--research-muted, #726c5f);
  font-family: var(--research-sans);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.research-topic-badge {
  background: rgba(114, 108, 95, 0.08);
  border: 1px solid rgba(114, 108, 95, 0.15);
  border-radius: 12px;
  color: var(--research-muted, #726c5f);
  font-family: var(--research-sans);
  font-size: 11px;
  font-weight: 600;
  padding: 2px 9px;
  letter-spacing: 0.02em;
}

.research-topic-badge.is-china {
  background: rgba(184, 75, 41, 0.08);
  border-color: rgba(184, 75, 41, 0.22);
  color: #a33816;
}

.research-topic-badge.is-japan {
  background: rgba(30, 90, 142, 0.08);
  border-color: rgba(30, 90, 142, 0.22);
  color: #1a5686;
}

.research-topic-card strong {
  color: var(--research-ink, #1d1c18);
  font-family: var(--research-display);
  font-size: 19px;
  font-weight: 600;
  letter-spacing: -0.01em;
  margin-bottom: 8px;
  display: block;
  transition: color 0.16s ease;
}

.research-topic-card:hover strong {
  color: var(--research-blue, #2f55d4);
}

.research-topic-card small {
  color: var(--research-muted, #726c5f);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 13px;
  line-height: 1.65;
  flex: 1;
  display: block;
}

.research-topic-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18px;
  padding-top: 12px;
  border-top: 1px dashed rgba(155, 149, 137, 0.25);
  color: var(--research-muted, #726c5f);
  font-size: 12px;
  font-weight: 600;
  font-family: var(--research-sans);
}

.research-topic-card:hover .research-topic-card-footer {
  color: var(--research-blue, #2f55d4);
}

.research-topic-card-footer i {
  font-size: 11px;
  transition: transform 0.16s ease;
}

.research-topic-card:hover .research-topic-card-footer i {
  transform: translateX(3px);
}

.research-topic-hub-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-top: 36px;
}

.research-topic-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 9px 20px;
  background: var(--weekly-card-bg, #ffffff);
  border: 1px solid var(--weekly-card-border, rgba(29, 28, 24, 0.12));
  border-radius: 6px;
  color: var(--research-ink, #1d1c18);
  font-family: var(--research-sans);
  font-size: 13px;
  font-weight: 600;
  text-decoration: none !important;
  transition: all 0.18s ease;
}

.research-topic-action-btn:hover {
  border-color: var(--research-blue, #2f55d4);
  color: var(--research-blue, #2f55d4);
  background: #fbfbf9;
  transform: translateY(-1px);
}

.portfolio-essay-language-note {
  color: var(--research-muted);
  font-family: var(--research-serif);
  font-size: 13px;
  line-height: 1.55;
  margin: 10px 0 0;
}

.portfolio-essay-search {
  align-items: center;
  display: flex;
  gap: 12px;
  margin-top: 24px;
  max-width: 560px;
}

.portfolio-search-input {
  background: transparent;
  border: 1px solid var(--research-line);
  border-radius: 0;
  color: var(--research-ink);
  flex: 1;
  font: 14px var(--research-sans);
  min-height: 39px;
  padding: 9px 12px;
}

.portfolio-search-input::placeholder {
  color: var(--research-muted);
}

.portfolio-search-input:focus {
  border-color: var(--research-blue);
  outline: 3px solid rgba(47, 85, 212, .18);
  outline-offset: 2px;
}

@media (max-width: 760px) {
  .research-taxonomy-page,
  .research-topic-hub {
    padding: 48px 0 64px;
  }

  .research-topic-hub-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
}

@media (max-width: 580px) {
  .research-topic-hub-grid {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .research-topic-hub-actions {
    flex-direction: column;
    width: 100%;
  }

  .research-topic-action-btn {
    width: 100%;
    justify-content: center;
  }

  .portfolio-essay-search {
    align-items: flex-start;
    flex-direction: column;
  }

  .portfolio-search-input {
    width: 100%;
  }
}

/* Turn weekly data tables into compact research cards. The table semantics stay
 * intact, while each row becomes a scannable indicator card. */
.portfolio-data-radar {
  margin: 1.4rem 0 2.8rem;
}

.portfolio-data-radar-table {
  border-collapse: separate;
  border-spacing: 0;
  display: block;
  font-family: var(--research-sans);
  font-size: 13px;
  line-height: 1.55;
  margin: 0;
  width: 100%;
}

.portfolio-data-radar-table thead {
  display: none;
}

.portfolio-data-radar-table tbody {
  display: grid;
  gap: 14px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.portfolio-data-radar-table tbody tr {
  background: rgba(255, 255, 255, .34);
  border: 1px solid var(--research-line);
  border-top: 3px solid var(--research-blue);
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  min-width: 0;
  transition: background .2s ease, transform .2s ease;
}

.portfolio-data-radar-table tbody tr:hover {
  background: rgba(255, 255, 255, .68);
  transform: translateY(-2px);
}

.portfolio-data-radar-table td {
  border: 0;
  border-bottom: 1px solid rgba(145, 137, 123, .32);
  display: block;
  min-width: 0;
  overflow-wrap: anywhere;
  padding: 13px 15px 14px;
  text-align: left !important;
  vertical-align: top;
}

.portfolio-data-radar-table td:first-child {
  border-bottom-color: var(--research-line);
  color: var(--research-ink);
  font-family: var(--research-serif);
  font-size: 17px;
  font-weight: 600;
  grid-column: 1 / -1;
  line-height: 1.35;
  padding-bottom: 11px;
}

.portfolio-data-radar-table td:not(:first-child)::before {
  color: var(--research-muted);
  content: attr(data-label);
  display: block;
  font-family: var(--research-sans);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .1em;
  line-height: 1.2;
  margin-bottom: 5px;
  text-transform: uppercase;
}

.portfolio-data-radar-table td[data-radar-role="actual"] {
  color: var(--research-blue);
  font-family: var(--research-serif);
  font-size: 22px;
  font-weight: 600;
  letter-spacing: -.015em;
  line-height: 1.2;
}

.portfolio-data-radar-table td[data-radar-role="meaning"] {
  color: #4e4a42;
}

.portfolio-data-radar-chart {
  background: #f0efeb;
  border-top: 3px solid var(--research-blue);
  margin: 0 0 14px;
  padding: 22px 24px 18px;
}

.portfolio-data-radar-chart-head {
  margin-bottom: 4px;
}

.portfolio-data-radar-chart-kicker,
.portfolio-data-radar-chart-source {
  color: var(--research-muted);
  font-family: var(--research-sans);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .1em;
  line-height: 1.4;
  margin: 0;
  text-transform: uppercase;
}

.portfolio-data-radar-chart-head h3 {
  color: var(--research-ink);
  font-family: var(--research-serif);
  font-size: 22px;
  font-weight: 600;
  letter-spacing: -.015em;
  line-height: 1.25;
  margin: 7px 0 3px;
}

.portfolio-data-radar-chart-sub {
  color: var(--research-muted);
  font-family: var(--research-sans);
  font-size: 11px;
  line-height: 1.5;
  margin: 0;
}

.portfolio-data-radar-chart svg {
  display: block;
  height: auto;
  margin: 10px 0 0;
  max-height: 300px;
  width: 100%;
}

.portfolio-data-radar-chart svg text {
  font-family: var(--research-sans);
}

.portfolio-data-radar-chart-legend {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  font-family: var(--research-sans);
  font-size: 10px;
  gap: 14px;
  margin: -2px 0 12px;
}

.portfolio-data-radar-chart-legend span {
  align-items: center;
  color: var(--research-muted);
  display: inline-flex;
  gap: 6px;
}

.portfolio-data-radar-chart-legend span::before {
  border: 1px solid var(--research-ink);
  border-radius: 50%;
  content: "";
  display: inline-block;
  height: 8px;
  width: 8px;
}

.portfolio-data-radar-chart-legend .is-actual {
  color: var(--research-blue);
  font-weight: 700;
}

.portfolio-data-radar-chart-legend .is-actual::before {
  background: var(--research-blue);
  border-color: var(--research-blue);
}

.portfolio-data-radar-chart-source {
  border-top: 1px solid rgba(145, 137, 123, .35);
  padding-top: 10px;
}

@media (max-width: 760px) {
  .portfolio-data-radar {
    margin-left: -2px;
    margin-right: -2px;
  }

  .portfolio-data-radar-table tbody,
  .portfolio-data-radar-table tbody tr {
    grid-template-columns: 1fr;
  }

  .portfolio-data-radar-table td:first-child {
    grid-column: auto;
  }

  .portfolio-data-radar-table td[data-radar-role="actual"] {
    font-size: 24px;
  }

  .portfolio-data-radar-chart {
    padding: 19px 15px 16px;
  }

  .portfolio-data-radar-chart-head h3 {
    font-size: 20px;
  }
}

/* ==========================================================================
   Weekly Political Economy Product Line (R1-R7)
   Unified Dual Briefs, Data Radar, Compare Table, Mainline Chart & Homepage IA
   ========================================================================== */

:root {
  --weekly-china: #b35922;
  --weekly-china-bg: #faf4ed;
  --weekly-japan: #3a5a6b;
  --weekly-japan-bg: #edf2f5;
  --weekly-card-bg: rgba(255, 255, 255, 0.65);
  --weekly-card-border: #d5cfc4;
}

/* --- R5: Homepage Dual Weekly Section --- */
.weekly-product-section {
  border-bottom: 1px solid var(--research-line);
  margin-bottom: 36px;
  padding-bottom: 40px;
}

.weekly-section-kicker-row {
  align-items: baseline;
  display: flex;
  justify-content: space-between;
  margin-bottom: 20px;
}

.weekly-section-kicker {
  color: var(--research-blue);
  font-family: var(--research-sans);
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 0.14em;
  margin: 0;
  text-transform: uppercase;
}

.weekly-section-archive-links {
  display: flex;
  gap: 16px;
  font-size: 13px;
  font-family: var(--research-sans);
}

.weekly-section-archive-links a {
  border-bottom: 1px solid var(--research-line);
  color: var(--research-muted);
  text-decoration: none;
}

.weekly-section-archive-links a:hover {
  border-color: var(--research-blue);
  color: var(--research-blue);
}

.weekly-dual-briefs {
  display: grid;
  gap: 24px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-bottom: 20px;
}

.weekly-brief-card {
  background: var(--weekly-card-bg);
  border: 1px solid var(--weekly-card-border);
  display: flex;
  flex-direction: column;
  padding: 24px 28px 22px;
  position: relative;
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}

.weekly-brief-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(29, 28, 24, 0.06);
}

.weekly-brief-card.is-china {
  border-top: 4px solid var(--weekly-china);
}

.weekly-brief-card.is-japan {
  border-top: 4px solid var(--weekly-japan);
}

.weekly-brief-header {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 12px;
}

.weekly-brief-kicker {
  font-family: var(--research-sans);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.weekly-brief-card.is-china .weekly-brief-kicker {
  color: var(--weekly-china);
}

.weekly-brief-card.is-japan .weekly-brief-kicker {
  color: var(--weekly-japan);
}

.weekly-brief-date {
  color: var(--research-muted);
  font-family: var(--research-sans);
  font-size: 12px;
  font-variant-numeric: tabular-nums;
}

.weekly-brief-title {
  font-family: var(--research-display);
  font-size: clamp(20px, 1.7vw, 25px);
  font-weight: 600;
  letter-spacing: -0.02em;
  line-height: 1.22;
  margin: 0 0 12px;
}

.weekly-brief-title a {
  color: var(--research-ink);
  text-decoration: none;
}

.weekly-brief-title a:hover {
  color: var(--research-blue);
}

.weekly-brief-mainline {
  color: var(--research-muted);
  font-family: var(--research-serif);
  font-size: 15px;
  line-height: 1.5;
  margin: 0 0 16px;
}

.weekly-brief-footer {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 10px;
}

/* Card CTA: comfortable 44px tap target on touch screens. */
.weekly-brief-footer .research-arrow-link {
  min-height: 44px;
  padding: 10px 0;
}

/* R5b: second brief collapsed to a quiet push row on small screens
   (desktop keeps the two-card grid, so this row is hidden there). */
.weekly-brief-link-row {
  border-top: 1px dashed var(--research-line);
  display: none;
  margin: -8px 4px 24px;
}

.weekly-brief-link-row a {
  align-items: center;
  color: var(--research-ink);
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  min-height: 44px;
  text-decoration: none;
}

.weekly-brief-link-row a:hover {
  color: var(--research-blue);
}

.weekly-brief-link-row a:hover i {
  transform: translateX(3px);
}

.weekly-brief-link-row i {
  font-size: 11px;
  transition: transform 0.16s ease;
}

.weekly-link-kicker {
  color: var(--weekly-japan);
  font-family: var(--research-sans);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.weekly-link-title {
  font-family: var(--research-sans);
  font-size: 14px;
}

/* Shared Sino-Japan Compare One-Liner Bar */
.weekly-shared-compare {
  align-items: center;
  background: #f0eae1;
  border: 1px solid var(--weekly-card-border);
  border-left: 4px solid var(--research-ink);
  display: flex;
  gap: 16px;
  padding: 14px 20px;
  margin-bottom: 24px;
}

.weekly-compare-badge {
  background: var(--research-ink);
  color: #fff;
  font-family: var(--research-sans);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.08em;
  padding: 3px 8px;
  text-transform: uppercase;
  white-space: nowrap;
}

.weekly-shared-compare p {
  color: var(--research-ink);
  font-family: var(--research-serif);
  font-size: 15px;
  font-weight: 600;
  line-height: 1.45;
  margin: 0;
}

/* --- R5: Homepage Visualization & Observatory Bar --- */
.weekly-viz-bar {
  background: rgba(255, 255, 255, 0.45);
  border: 1px solid var(--research-line);
  display: grid;
  gap: 20px;
  grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.6fr);
  margin-bottom: 40px;
  padding: 20px 24px;
}

.weekly-viz-metrics-group {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.weekly-viz-group-title {
  color: var(--research-muted);
  font-family: var(--research-sans);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.1em;
  margin: 0;
  text-transform: uppercase;
}

.weekly-viz-chips {
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.weekly-metric-chip {
  background: #fff;
  border: 1px solid var(--weekly-card-border);
  display: flex;
  flex-direction: column;
  padding: 10px 12px;
}

.weekly-metric-chip.is-china {
  border-top: 2px solid var(--weekly-china);
}

.weekly-metric-chip.is-japan {
  border-top: 2px solid var(--weekly-japan);
}

.weekly-chip-label {
  color: var(--research-muted);
  font-family: var(--research-sans);
  font-size: 11px;
  line-height: 1.2;
  margin-bottom: 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.weekly-chip-val-row {
  align-items: baseline;
  display: flex;
  gap: 6px;
}

.weekly-chip-val {
  color: var(--research-ink);
  font-family: var(--research-display);
  font-size: 17px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

.weekly-chip-dir {
  font-family: var(--research-sans);
  font-size: 12px;
  font-weight: 700;
}

.weekly-chip-dir.is-up {
  color: #c0392b;
}

.weekly-chip-dir.is-down {
  color: #27ae60;
}

.weekly-chip-dir.is-flat {
  color: var(--research-muted);
}

.weekly-viz-observatory-box {
  align-items: flex-start;
  border-left: 1px solid var(--research-line);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-left: 24px;
}

.weekly-observatory-meta {
  align-items: center;
  display: flex;
  gap: 10px;
  margin-bottom: 6px;
}

.weekly-observatory-meta strong {
  color: var(--research-blue);
  font-family: var(--research-sans);
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.weekly-observatory-meta span {
  color: var(--research-muted);
  font-family: var(--research-sans);
  font-size: 11px;
}

.weekly-viz-observatory-box p {
  color: var(--research-ink);
  font-family: var(--research-sans);
  font-size: 13px;
  line-height: 1.4;
  margin: 0 0 12px;
}

.weekly-observatory-cta {
  align-items: center;
  background: var(--research-blue);
  color: #fff !important;
  display: inline-flex;
  font-family: var(--research-sans);
  font-size: 12px;
  font-weight: 800;
  gap: 8px;
  letter-spacing: 0.04em;
  padding: 8px 16px;
  text-decoration: none;
  transition: background 0.16s ease;
}

.weekly-observatory-cta:hover {
  background: var(--research-blue-hover);
}

/* --- R3: Article Data Radar Grid & Cards --- */
.weekly-radar-panel {
  background: #fbf9f5;
  border: 1px solid var(--weekly-card-border);
  margin: 28px 0;
  padding: 22px 24px 20px;
}

.weekly-radar-head {
  border-bottom: 1px solid var(--research-line);
  display: flex;
  justify-content: space-between;
  margin-bottom: 18px;
  padding-bottom: 10px;
}

.weekly-radar-head h3 {
  font-family: var(--research-display);
  font-size: 20px;
  font-weight: 600;
  margin: 0;
}

.weekly-radar-head span {
  color: var(--research-muted);
  font-family: var(--research-sans);
  font-size: 12px;
}

.weekly-radar-grid {
  display: grid;
  gap: 16px;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.weekly-radar-card {
  background: #fff;
  border: 1px solid var(--weekly-card-border);
  display: flex;
  flex-direction: column;
  padding: 16px 18px 14px;
}

.weekly-radar-card.is-china {
  border-top: 3px solid var(--weekly-china);
}

.weekly-radar-card.is-japan {
  border-top: 3px solid var(--weekly-japan);
}

.weekly-radar-card-head {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
}

.weekly-radar-tag {
  font-family: var(--research-sans);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.weekly-radar-card.is-china .weekly-radar-tag {
  color: var(--weekly-china);
}

.weekly-radar-card.is-japan .weekly-radar-tag {
  color: var(--weekly-japan);
}

.weekly-radar-label {
  color: var(--research-ink);
  font-family: var(--research-sans);
  font-size: 14px;
  font-weight: 700;
  margin: 0 0 10px;
}

.weekly-radar-metric-body {
  align-items: baseline;
  display: flex;
  gap: 10px;
  margin-bottom: 8px;
}

.weekly-radar-value {
  font-family: var(--research-display);
  font-size: 28px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

.weekly-radar-change {
  align-items: center;
  display: inline-flex;
  font-family: var(--research-sans);
  font-size: 13px;
  font-weight: 700;
  gap: 4px;
}

.weekly-radar-change.is-up {
  color: #c0392b;
}

.weekly-radar-change.is-down {
  color: #27ae60;
}

.weekly-radar-change.is-flat {
  color: var(--research-muted);
}

.weekly-radar-note {
  color: var(--research-muted);
  font-family: var(--research-sans);
  font-size: 12px;
  line-height: 1.4;
  margin: 0 0 10px;
}

.weekly-sparkline-svg {
  display: block;
  height: 28px;
  margin-top: auto;
  width: 100%;
}

/* --- R8: Enhanced Visual Radar Table & Mini-Gauges --- */
.weekly-radar-table-wrap {
  background: #fbf9f5;
  border: 1px solid var(--weekly-card-border);
  margin: 24px 0 28px;
  padding: 20px 22px;
}

.weekly-radar-table-head {
  align-items: baseline;
  border-bottom: 1px solid var(--research-line);
  display: flex;
  justify-content: space-between;
  margin-bottom: 14px;
  padding-bottom: 10px;
}

.weekly-radar-table-head h4 {
  color: var(--research-ink);
  font-family: var(--research-display);
  font-size: 17px;
  font-weight: 700;
  margin: 0;
}

.weekly-radar-table-head span {
  color: var(--research-muted);
  font-family: var(--research-sans);
  font-size: 12px;
}

.weekly-radar-table-scroll {
  -webkit-overflow-scrolling: touch;
  overflow-x: auto;
}

.weekly-radar-table {
  border-collapse: collapse;
  font-family: var(--research-sans);
  font-size: 13px;
  line-height: 1.45;
  margin: 0;
  width: 100%;
}

.weekly-radar-table th {
  background: #ede8df;
  border: 1px solid var(--weekly-card-border);
  color: var(--research-ink);
  font-weight: 700;
  padding: 9px 12px;
  text-align: left;
  white-space: nowrap;
}

.weekly-radar-table td {
  background: #ffffff;
  border: 1px solid var(--weekly-card-border);
  padding: 10px 12px;
  vertical-align: middle;
}

.weekly-radar-table tr:nth-child(even) td {
  background: #fdfbf7;
}

.weekly-radar-table .col-metric {
  font-weight: 600;
  min-width: 140px;
}

.weekly-radar-table .col-val {
  font-family: var(--research-display);
  font-size: 17px;
  font-variant-numeric: tabular-nums;
  font-weight: 700;
  min-width: 80px;
  white-space: nowrap;
}

.weekly-radar-table .col-gauge {
  min-width: 170px;
}

.weekly-radar-table .col-trend {
  min-width: 100px;
  white-space: nowrap;
}

.weekly-radar-table .col-note {
  color: #555;
  font-size: 12px;
  line-height: 1.4;
  min-width: 200px;
}

/* Category Badges */
.radar-cat-badge {
  border-radius: 2px;
  display: inline-block;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.05em;
  margin-right: 6px;
  padding: 1px 5px;
  text-transform: uppercase;
  vertical-align: middle;
}

.radar-cat-badge.is-china {
  background: rgba(179, 89, 34, 0.12);
  border: 1px solid rgba(179, 89, 34, 0.28);
  color: #b35922;
}

.radar-cat-badge.is-japan {
  background: rgba(58, 90, 107, 0.12);
  border: 1px solid rgba(58, 90, 107, 0.28);
  color: #3a5a6b;
}

/* Trend Pills */
.radar-trend-pill {
  align-items: center;
  border-radius: 12px;
  display: inline-flex;
  font-size: 11px;
  font-weight: 700;
  gap: 4px;
  padding: 2px 8px;
  white-space: nowrap;
}

.radar-trend-pill.is-up {
  background: #e8f5e9;
  border: 1px solid #c8e6c9;
  color: #1b5e20;
}

.radar-trend-pill.is-down {
  background: #ffebee;
  border: 1px solid #ffcdd2;
  color: #b71c1c;
}

.radar-trend-pill.is-flat {
  background: #f5f5f5;
  border: 1px solid #e0e0e0;
  color: #616161;
}

.radar-trend-pill.is-warn {
  background: #fff3e0;
  border: 1px solid #ffe0b2;
  color: #b35922;
}

/* Mini Visual Gauge Bar (CSS Range Tracker) */
.radar-mini-gauge {
  display: flex;
  flex-direction: column;
  gap: 3px;
  width: 100%;
}

.radar-gauge-track {
  background: #e5e0d5;
  border-radius: 4px;
  height: 8px;
  overflow: visible;
  position: relative;
}

.radar-gauge-fill {
  border-radius: 4px;
  height: 100%;
  transition: width 0.25s ease;
}

.radar-gauge-fill.is-up {
  background: #2d6a4f;
}

.radar-gauge-fill.is-down {
  background: #9b2226;
}

.radar-gauge-fill.is-warn {
  background: #b35922;
}

.radar-gauge-fill.is-neutral {
  background: #6c757d;
}

.radar-gauge-midline {
  background: #1d1c18;
  bottom: -3px;
  position: absolute;
  top: -3px;
  width: 2px;
  z-index: 2;
}

.radar-gauge-val-marker {
  background: #1d1c18;
  border-radius: 1px;
  height: 14px;
  position: absolute;
  top: -3px;
  transform: translateX(-50%);
  width: 4px;
  z-index: 3;
}

.radar-gauge-labels {
  color: var(--research-muted);
  display: flex;
  font-size: 10px;
  justify-content: space-between;
  line-height: 1;
}

.radar-midline-label {
  color: var(--research-ink);
  font-weight: 700;
}

/* --- R2: Sino-Japan Comparison Component --- */
.weekly-compare-section {
  background: #fbf9f5;
  border: 1px solid var(--weekly-card-border);
  border-left: 4px solid var(--research-blue);
  margin: 28px 0;
  padding: 22px 24px;
}

.weekly-compare-intro {
  color: var(--research-ink);
  font-family: var(--research-serif);
  font-size: 16px;
  font-weight: 600;
  line-height: 1.5;
  margin: 0 0 18px;
}

.weekly-compare-table {
  border-collapse: collapse;
  font-family: var(--research-sans);
  font-size: 13px;
  line-height: 1.5;
  margin: 0;
  width: 100%;
}

.weekly-compare-table th {
  background: #ede8df;
  border: 1px solid var(--weekly-card-border);
  color: var(--research-ink);
  font-weight: 800;
  padding: 10px 12px;
  text-align: left;
}

.weekly-compare-table td {
  border: 1px solid var(--weekly-card-border);
  padding: 10px 12px;
  vertical-align: top;
}

.weekly-compare-table tr:nth-child(even) td {
  background: rgba(255, 255, 255, 0.5);
}

.weekly-axis-badge {
  font-weight: 800;
  white-space: nowrap;
}

/* --- R4: Weekly Mainline Figure --- */
.weekly-mainline-figure {
  background: #fff;
  border: 1px solid var(--weekly-card-border);
  margin: 24px 0 28px;
  padding: 18px 20px 14px;
  text-align: center;
}

.weekly-mainline-figure img,
.weekly-mainline-figure svg {
  display: block;
  height: auto !important;
  margin: 0 auto 12px;
  max-width: 100%;
}

.weekly-mainline-figure .article-img-link {
  display: block;
  margin: 0 auto 12px;
}

.weekly-figure-caption {
  color: var(--research-muted);
  font-family: var(--research-serif);
  font-size: 14px;
  font-style: italic;
  line-height: 1.45;
  margin: 0;
}

.weekly-figure-caption strong {
  color: var(--research-ink);
  font-style: normal;
}

/* --- Core Event Four-Field Grammar (Lightweight) ---
   Transforms the markdown list (发生了什么 / 为什么重要 / 接下来关注什么 /
   来源) into a semantic four-role grammar: fact (neutral baseline),
   judgment (country-color left bar + label), watch (cobalt-blue action
   list), source (quiet metadata). Drafts stay plain markdown; the
   transformation happens in scripts/weekly-fields.js. */
.weekly-event-fields {
  margin: 18px 0 26px;
}

.weekly-event-tag {
  display: block;
  font-family: var(--research-sans);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.12em;
  margin-bottom: 5px;
  text-transform: uppercase;
}

.weekly-event-fact {
  margin: 0 0 16px;
}

.weekly-event-fact .weekly-event-tag {
  color: var(--research-muted);
}

.weekly-event-judgment {
  border-left: 4px solid var(--weekly-china);
  margin: 0 0 16px;
  padding: 2px 0 2px 16px;
}

.weekly-event-judgment .weekly-event-tag {
  color: var(--weekly-china);
}

.weekly-event-fields.is-japan .weekly-event-judgment {
  border-left-color: var(--weekly-japan);
}

.weekly-event-fields.is-japan .weekly-event-judgment .weekly-event-tag {
  color: var(--weekly-japan);
}

.weekly-event-judgment p {
  margin: 0;
}

.weekly-event-watch {
  border-top: 1px dashed var(--research-line);
  margin: 0 0 14px;
  padding-top: 12px;
}

.weekly-event-watch .weekly-event-tag {
  color: var(--research-blue);
}

.weekly-event-watch p {
  font-family: var(--research-sans);
  font-size: 15px;
  line-height: 1.7;
  margin: 0;
  padding-left: 16px;
  position: relative;
}

.weekly-event-watch p::before {
  color: var(--research-blue);
  content: "▸";
  font-size: 13px;
  left: 0;
  position: absolute;
  top: 0.15em;
}

.weekly-event-source {
  color: var(--research-muted);
  font-family: var(--research-sans);
  font-size: 12px;
  letter-spacing: 0.02em;
  margin: 0;
}

.weekly-event-source a {
  color: var(--research-muted);
  text-decoration: none;
  border-bottom: 1px solid var(--research-line);
}

.weekly-event-source a:hover {
  color: var(--research-blue);
  border-color: var(--research-blue);
}

/* --- Weekly ECharts Component (progressive enhancement) ---
   Interactive radar / bar charts rendered by source/js/weekly-charts.js.
   The static fallback table stays visible without JS; the loader replaces
   it with an ECharts canvas only when the library is available. */
.weekly-chart {
  background: #fbf9f5;
  border: 1px solid var(--weekly-card-border);
  margin: 24px 0 28px;
  padding: 18px 20px 16px;
}

.weekly-chart-head {
  align-items: baseline;
  border-bottom: 1px solid var(--research-line);
  display: flex;
  justify-content: space-between;
  margin-bottom: 12px;
  padding-bottom: 10px;
}

.weekly-chart-head h4 {
  font-family: var(--research-display);
  font-size: 17px;
  font-weight: 700;
  margin: 0;
}

.weekly-chart-head span {
  color: var(--research-muted);
  font-family: var(--research-sans);
  font-size: 12px;
}

.weekly-chart-canvas {
  height: 380px;
  width: 100%;
}

.weekly-chart-fallback {
  color: var(--research-muted);
  font-family: var(--research-sans);
  font-size: 13px;
  line-height: 1.6;
}

.weekly-chart-fallback table {
  border-collapse: collapse;
  font-size: 13px;
  margin: 0;
  width: 100%;
}

.weekly-chart-fallback th,
.weekly-chart-fallback td {
  border: 1px solid var(--weekly-card-border);
  padding: 6px 10px;
  text-align: left;
}

.weekly-chart-fallback th {
  background: #ede8df;
  font-weight: 700;
}

@media (max-width: 800px) {
  .weekly-chart-canvas {
    height: 320px;
  }
}

/* --- Responsive Media Queries (Mobile & Tablet) --- */
@media (max-width: 800px) {
  .weekly-dual-briefs {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  /* First screen: one featured card (China). The Japan brief collapses
     into the 同步推送 link row below to cut visual density. */
  .weekly-brief-card.is-japan {
    display: none;
  }

  .weekly-brief-link-row {
    display: block;
  }

  .weekly-brief-card {
    padding: 22px 20px 20px;
  }

  .weekly-shared-compare {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .weekly-viz-bar {
    grid-template-columns: 1fr;
    padding: 18px;
  }

  .weekly-viz-chips {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .weekly-viz-observatory-box {
    border-left: none;
    border-top: 1px solid var(--research-line);
    padding-left: 0;
    padding-top: 16px;
  }

  .weekly-radar-grid {
    grid-template-columns: 1fr;
  }

  .weekly-compare-table {
    display: block;
    overflow-x: auto;
  }
}

/* --- Life Stream & Field Notes (Inspired by before.town) --- */
.life-channel-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 36px;
  margin-bottom: 28px;
  max-width: 720px;
  padding-bottom: 18px;
  border-bottom: 1px solid var(--portfolio-rule);
}

.life-channel-chips {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.life-chip {
  background: transparent;
  border: 1px solid var(--portfolio-rule);
  border-radius: 999px;
  color: var(--portfolio-ink);
  cursor: pointer;
  font-family: var(--research-sans);
  font-size: 13px;
  font-weight: 500;
  line-height: 1;
  padding: 8px 14px;
  transition: all 0.2s ease;
}

.life-chip:hover {
  border-color: var(--portfolio-blue);
  color: var(--portfolio-blue);
}

.life-chip.is-active {
  background: var(--portfolio-ink);
  border-color: var(--portfolio-ink);
  color: var(--portfolio-paper);
}

.life-chip-count {
  font-size: 11px;
  opacity: 0.7;
  margin-left: 4px;
}

.life-channel-links {
  display: flex;
  align-items: center;
  gap: 16px;
}

.life-channel-link {
  color: var(--portfolio-muted);
  font-size: 13px;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: color 0.2s ease;
}

.life-channel-link span {
  font-family: var(--research-sans);
  font-size: 11px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.life-channel-link:hover {
  color: var(--portfolio-blue);
}

/* Life Stream Feed */
.life-stream-container {
  display: flex;
  flex-direction: column;
  gap: 24px;
  max-width: 720px;
