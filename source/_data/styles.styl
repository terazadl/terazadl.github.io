  justify-content: space-between;
  margin-top: auto;
  padding-top: 14px;
  flex-wrap: wrap;
  gap: 12px;
}

.weekly-issue-actions {
  align-items: center;
  display: flex;
  gap: 10px;
}

.weekly-issue-lang-links {
  align-items: center;
  color: var(--research-muted);
