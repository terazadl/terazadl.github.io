:root {
  --portfolio-paper: #f5f1e8;
  --portfolio-ink: #171714;
  --portfolio-muted: #6f6b62;
  --portfolio-rule: #9b9589;
  --portfolio-blue: #2f55d4;
  --portfolio-blue-dark: #2144bd;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--portfolio-paper);
  color: var(--portfolio-ink);
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

body.portfolio-home-page.sidebar-active,
body.portfolio-about-page.sidebar-active {
  padding-left: 0 !important;
}

a {
  color: inherit;
}

/* --- Global Responsive Media & Anti-Distortion Rules --- */
img,
svg,
video,
iframe {
  max-width: 100%;
  height: auto;
}

.headband {
  display: none;
}

header.header {
  box-sizing: border-box;
  max-width: none;
  padding: 21px 48px 0;
  width: 100%;
}

header.header > .site-brand-container,
header.header > .site-nav {
  display: none !important;
}

.portfolio-site-header {
  align-items: center;
  border-bottom: 1px solid var(--portfolio-ink);
  display: flex;
  justify-content: space-between;
  min-height: 0;
  padding-bottom: 19px;
}

.portfolio-brand {
  align-items: center;
  border: 0;
  display: flex;
  gap: 17px;
  text-decoration: none;
}

.portfolio-brand:hover {
  color: inherit;
}

.portfolio-brand-name {
  font-family: "Noto Serif SC", Georgia, "Times New Roman", serif;
  font-size: 26px;
  font-weight: 600;
  letter-spacing: -.03em;
  line-height: 1;
}

.portfolio-brand-divider {
  background: var(--portfolio-rule);
  display: block;
  height: 31px;
  width: 1px;
}

.portfolio-brand-field {
  font-size: 13px;
  font-weight: 500;
  letter-spacing: .015em;
}

.portfolio-nav {
  align-items: center;
  display: flex;
  gap: 35px;
}

.portfolio-nav a {
  border: 0;
  font-size: 12px;
  font-weight: 500;
  letter-spacing: .07em;
  padding: 8px 0;
  position: relative;
  text-transform: uppercase;
}

.portfolio-nav a::after {
  background: var(--portfolio-blue);
  bottom: 1px;
  content: "";
  height: 2px;
  left: 0;
  position: absolute;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform .18s ease;
  width: 100%;
}

.portfolio-nav a:hover,
.portfolio-nav a.is-active {
  color: var(--portfolio-blue);
}

.portfolio-nav a:hover::after,
.portfolio-nav a.is-active::after {
  transform: scaleX(1);
}

.portfolio-home-page .main-inner {
  box-sizing: border-box;
  max-width: none;
  padding: 0 48px;
  width: 100%;
}

.portfolio-home-page .post-block {
  background: transparent;
  box-shadow: none;
  margin: 0;
  padding: 0;
}

.portfolio-home-page .post-body {
  color: var(--portfolio-ink);
  font-size: 16px;
  padding: 0;
}

.portfolio-home-page .sidebar,
.portfolio-home-page .sidebar-toggle,
.portfolio-about-page .sidebar,
.portfolio-about-page .sidebar-toggle {
  display: none !important;
}

.portfolio-home-page .post-body > script + .portfolio-home {
  margin-top: 0;
}

.portfolio-hero {
  box-sizing: border-box;
  display: grid;
  grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
  min-height: 486px;
  padding: 80px 0 30px;
}

.portfolio-intro {
  border-right: 1px solid var(--portfolio-rule);
  padding: 0 15px 0 0;
}

.portfolio-intro h1,
.portfolio-featured h2,
.portfolio-section-heading h2,
.portfolio-about h1 {
  font-family: "Noto Serif SC", Georgia, "Times New Roman", serif;
  text-rendering: optimizeLegibility;
}

.portfolio-intro h1 {
  font-size: clamp(44px, 3.75vw, 54px);
  font-weight: 600;
  letter-spacing: -.045em;
  line-height: 1.08;
  margin: -6px 0 24px;
}

.portfolio-intro-cn {
  color: var(--portfolio-muted);
  font-family: "Noto Serif SC", "Songti SC", serif;
  font-size: 15px;
  letter-spacing: .03em;
  margin: 0;
}

.portfolio-actions {
  align-items: center;
  display: flex;
  gap: 31px;
  margin-top: 38px;
}

.portfolio-button {
  background: var(--portfolio-blue);
  border: 1px solid var(--portfolio-blue);
  color: #fff !important;
  display: inline-block;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .045em;
  padding: 13px 20px;
  text-transform: uppercase;
}

.portfolio-button:hover {
  background: var(--portfolio-blue-dark);
  border-color: var(--portfolio-blue-dark);
}

.portfolio-text-link,
.portfolio-read-link,
.portfolio-all-writing {
  border-bottom: 1px solid currentColor;
  display: inline-flex;
  font-size: 12px;
  font-weight: 600;
  gap: 9px;
  letter-spacing: .045em;
  padding-bottom: 3px;
  text-transform: uppercase;
}

.portfolio-text-link:hover,
.portfolio-read-link:hover,
.portfolio-all-writing:hover {
  color: var(--portfolio-blue);
}

.portfolio-featured {
  padding: 4px 12px 0 18px;
}

.portfolio-kicker {
  color: var(--portfolio-muted);
  font-family: var(--research-sans);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .14em;
  margin: 0 0 14px;
  text-transform: uppercase;
  opacity: 0.85;
}

.portfolio-about > .portfolio-kicker {
  font-size: 16px;
  font-weight: 700;
  letter-spacing: .08em;
  margin-bottom: 30px;
}

.portfolio-featured h2 {
  font-size: clamp(28px, 2.5vw, 38px);
  font-weight: 600;
  letter-spacing: -.025em;
  line-height: 1.32;
  margin: 0 0 20px;
}

.portfolio-meta {
  color: var(--portfolio-muted);
  font-size: 11px;
  letter-spacing: .05em;
  margin: 0 0 27px;
  text-transform: uppercase;
}

.portfolio-meta span {
  margin: 0 7px;
}

.portfolio-abstract {
  color: #44413a;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 15px;
  line-height: 1.68;
  margin: 0 0 28px;
  max-width: 610px;
}

.portfolio-selected {
  border-top: 1px solid var(--portfolio-ink);
  padding: 20px 0 46px;
}

.portfolio-section-heading {
  align-items: center;
  display: flex;
  gap: 28px;
  margin-bottom: 17px;
}

.portfolio-section-heading h2 {
  flex: none;
  font-size: 23px;
  font-weight: 600;
  letter-spacing: -.02em;
  margin: 0;
}

.portfolio-section-heading > span {
  background: var(--portfolio-rule);
  height: 1px;
  width: 100%;
}

.portfolio-writing-list {
  border-top: 1px solid var(--portfolio-rule);
}

.portfolio-writing-row {
  align-items: center;
  border-bottom: 1px solid var(--portfolio-rule);
  display: grid;
  gap: 30px;
  grid-template-columns: minmax(0, 1fr) minmax(330px, .48fr) 18px;
  padding: 17px 10px 17px 2px;
  text-decoration: none;
}

.portfolio-writing-row:hover {
  color: var(--portfolio-blue);
}

.portfolio-writing-title {
  font-family: "Noto Serif SC", Georgia, serif;
  font-size: 17px;
  font-weight: 600;
}

.portfolio-writing-meta {
  align-items: center;
  color: var(--portfolio-muted);
  display: grid;
  font-size: 11px;
  gap: 24px;
  grid-template-columns: 100px 1fr;
  letter-spacing: .03em;
}

.portfolio-writing-row:hover .portfolio-writing-meta {
  color: var(--portfolio-blue);
}

.portfolio-writing-row > i {
  font-size: 12px;
}

.portfolio-all-writing {
  margin-top: 25px;
}

.footer {
  color: var(--portfolio-muted);
  font-size: 10px;
  margin-top: 0;
  padding: 0 48px 31px;
}

.footer-inner {
  border-top: 1px solid var(--portfolio-rule);
  box-sizing: border-box;
  max-width: none;
  padding-top: 20px;
  width: 100%;
}

.portfolio-footer {
  align-items: center;
  display: flex;
  gap: 14px;
  justify-content: center;
  letter-spacing: .02em;
}

.portfolio-footer a {
  border-bottom: 1px solid var(--research-line);
  text-decoration: none;
}

.portfolio-footer a:hover {
  border-color: var(--research-blue);
  color: var(--research-blue);
}

.portfolio-footer-separator {
  background: var(--portfolio-rule);
  height: 10px;
  width: 1px;
}

.portfolio-about-page .main-inner {
  box-sizing: border-box;
  max-width: 1120px;
  padding-bottom: 90px;
  padding-top: 72px;
  width: calc(100% - 96px);
}

.portfolio-about-page .post-block {
  background: transparent;
  box-shadow: none;
}

.portfolio-about-page .post-header {
  display: none;
}

.portfolio-about {
  color: var(--portfolio-ink);
}

.portfolio-about-identity {
  align-items: center;
  display: flex;
  gap: 28px;
  margin-bottom: 52px;
}

.portfolio-about-identity img,
.portfolio-about-monogram {
  border: 1px solid var(--portfolio-rule);
  display: block;
  height: 96px;
  object-fit: cover;
  width: 96px;
}

.portfolio-about-monogram {
  align-items: center;
  background: var(--portfolio-paper);
  color: var(--portfolio-ink);
  display: flex;
  font-family: "Libre Caslon Display", Georgia, serif;
  font-size: 42px;
  justify-content: center;
  letter-spacing: -.08em;
  line-height: 1;
  padding-right: .08em;
}

.portfolio-about-identity h1 {
  font-size: clamp(45px, 5vw, 66px);
  font-weight: 600;
  letter-spacing: -.045em;
  line-height: 1.08;
  margin: 0 0 63px;
  max-width: 780px;
}

.portfolio-about-tagline {
  color: var(--portfolio-muted);
  font-family: "Noto Serif SC", Georgia, serif;
  font-size: 18px;
  margin: -36px 0 0;
}

.portfolio-about-grid {
  border-top: 1px solid var(--portfolio-ink);
  display: grid;
  gap: 70px;
  grid-template-columns: 1.1fr .9fr;
  padding-top: 38px;
}

.portfolio-about-lead {
  font-family: "Noto Serif SC", Georgia, serif;
  font-size: 21px;
  line-height: 1.65;
}

.portfolio-about-lead p:first-child {
  margin-top: 0;
}

.portfolio-about-details {
  color: #44413a;
}

.portfolio-about-details section {
  border-bottom: 1px solid var(--portfolio-rule);
  margin-bottom: 27px;
  padding-bottom: 24px;
}

.portfolio-about-details h2 {
  color: var(--portfolio-ink);
  font-size: 12px;
  letter-spacing: .1em;
  margin: 0 0 15px;
  text-transform: uppercase;
}

.portfolio-about-details p,
.portfolio-about-details li {
  font-size: 14px;
  line-height: 1.7;
}

.portfolio-about-details ul {
  margin: 0;
  padding-left: 19px;
}

.portfolio-about-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 28px;
}

.portfolio-article-next {
  border-top: 1px solid var(--portfolio-rule);
  margin-top: 52px;
  padding-top: 28px;
}

.portfolio-article-next h2 {
  font-family: "Noto Serif SC", Georgia, serif;
  font-size: 24px;
  font-weight: 500;
  margin: 0 0 18px;
}

.portfolio-article-next-list {
  display: grid;
  gap: 10px;
}

.portfolio-article-next-list a {
  border-bottom: 1px solid var(--portfolio-rule);
  display: block;
  font-size: 15px;
  padding: 10px 0;
  text-decoration: none;
}

.portfolio-article-next-list a:hover {
  border-color: var(--portfolio-blue);
  color: var(--portfolio-blue);
}

@media (max-width: 860px) {
  header.header {
    padding: 22px 22px 0;
  }

  .portfolio-site-header {
    align-items: flex-start;
    flex-direction: column;
    gap: 18px;
    padding-bottom: 16px;
  }

  .portfolio-brand {
    gap: 12px;
  }

  .portfolio-brand-name {
    font-size: 23px;
  }

  .portfolio-brand-divider {
    height: 25px;
  }

  .portfolio-brand-field {
    font-size: 11px;
  }

  .portfolio-nav {
    gap: 0;
    justify-content: space-between;
    width: 100%;
  }

  .portfolio-nav a {
    font-size: 10px;
  }

  .portfolio-home-page .main-inner {
    padding: 0 22px;
  }

  .portfolio-hero {
    display: block;
    padding: 49px 0 50px;
  }

  .portfolio-intro {
    border-bottom: 1px solid var(--portfolio-rule);
    border-right: 0;
    padding: 0 0 48px;
  }

  .portfolio-intro h1 {
    font-size: clamp(39px, 11.6vw, 54px);
    margin-top: 0;
  }

  .portfolio-featured {
    padding: 48px 0 0;
  }

  .portfolio-featured h2 {
    font-size: 29px;
  }

  .portfolio-writing-row {
    gap: 8px 18px;
    grid-template-columns: minmax(0, 1fr) 14px;
    padding: 18px 2px;
  }

  .portfolio-writing-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 14px;
    grid-column: 1;
    grid-row: 2;
  }

  .portfolio-writing-row > i {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  .footer {
    padding: 0 22px 24px;
  }

  .portfolio-footer {
    align-items: flex-start;
    flex-direction: column;
    gap: 6px;
  }

  .portfolio-footer-separator {
    display: none;
  }

  .portfolio-about-page .main-inner {
    padding-bottom: 60px;
    padding-top: 48px;
    width: calc(100% - 44px);
  }

  .portfolio-about-identity h1 {
    font-size: 44px;
    margin-bottom: 45px;
  }

  .portfolio-about-grid {
    display: block;
    padding-top: 28px;
  }

  .portfolio-about-lead {
    font-size: 18px;
    margin-bottom: 48px;
  }
}

@media (max-width: 430px) {
  .portfolio-brand-field {
    line-height: 1.3;
    max-width: 128px;
  }

  .portfolio-intro h1 {
    font-size: 40px;
  }

  .portfolio-actions {
    align-items: flex-start;
    flex-direction: column;
    gap: 20px;
    margin-top: 31px;
  }

  .portfolio-featured h2 {
    font-size: 27px;
  }
}

/* Credibility, bilingual publishing, and article-system refinements. */
.portfolio-credential-line {
  color: var(--portfolio-ink);
  font-size: 11px;
  letter-spacing: .035em;
  line-height: 1.6;
  margin: 18px 0 0;
  max-width: 430px;
  text-transform: uppercase;
}

.portfolio-topics {
  border-top: 1px solid var(--portfolio-ink);
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.portfolio-topics a {
  border: 0;
  border-right: 1px solid var(--portfolio-rule);
  display: grid;
  gap: 8px;
  grid-template-columns: 24px 1fr;
  padding: 23px 23px 25px 2px;
  text-decoration: none;
}

.portfolio-topics a + a {
  padding-left: 23px;
}

.portfolio-topics a:last-child {
  border-right: 0;
}

.portfolio-topics a:hover {
  color: var(--portfolio-blue);
}

.portfolio-topics span {
  color: var(--portfolio-blue);
  font-size: 10px;
  letter-spacing: .08em;
}

.portfolio-topics strong {
  font-family: "Newsreader", "Noto Serif SC", Georgia, serif;
  font-size: 20px;
  font-weight: 600;
  letter-spacing: -.01em;
}

.portfolio-topics small {
  color: var(--portfolio-muted);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 12px;
  grid-column: 2;
  line-height: 1.5;
  max-width: 260px;
}

.portfolio-writing-copy {
  display: grid;
  gap: 4px;
}

.portfolio-writing-deck {
  color: var(--portfolio-muted);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 12px;
  line-height: 1.45;
  max-width: 660px;
}

.portfolio-writing-row:hover .portfolio-writing-deck {
  color: var(--portfolio-blue);
}

.portfolio-about-links {
  list-style: none;
  padding-left: 0 !important;
}

.portfolio-about-links li {
  margin-bottom: 8px;
}

.portfolio-about-links a {
  border-bottom: 1px solid var(--portfolio-rule);
}

body:not(.portfolio-home-page):not(.portfolio-about-page) .main-inner {
  max-width: 1020px;
  width: calc(100% - 96px);
}

body:not(.portfolio-home-page):not(.portfolio-about-page) .post-block {
  background: transparent;
  box-shadow: none;
  padding-left: 0;
  padding-right: 0;
}

.post-title,
.post-title-link,
.post-body h1,
.post-body h2,
.post-body h3,
.post-body h4 {
  font-family: "Newsreader", "Noto Serif SC", Georgia, serif;
}

body:not(.portfolio-home-page):not(.portfolio-about-page) .post-title {
  font-size: clamp(31px, 4vw, 48px);
  font-weight: 600;
  letter-spacing: -.025em;
  line-height: 1.26;
}

body:not(.portfolio-home-page):not(.portfolio-about-page) .post-body {
  color: #302e29;
  font-family: "Newsreader", "Noto Serif SC", Georgia, serif;
  font-size: 18px;
  line-height: 1.92;
}

body:not(.portfolio-home-page):not(.portfolio-about-page) .post-body p,
body:not(.portfolio-home-page):not(.portfolio-about-page) .post-body li {
  letter-spacing: .005em;
}

body:not(.portfolio-home-page):not(.portfolio-about-page) .post-body h2 {
  border-bottom: 1px solid var(--portfolio-rule);
  font-size: 28px;
  font-weight: 600;
  letter-spacing: -.015em;
  margin-top: 2.4em;
  padding-bottom: .35em;
}

body:not(.portfolio-home-page):not(.portfolio-about-page) .post-body h3 {
  font-size: 22px;
  font-weight: 600;
  margin-top: 2em;
}

.post-body img {
  display: block;
  margin: 24px auto;
  max-width: 100%;
  height: auto !important;
  object-fit: contain;
  border-radius: 4px;
}

.post-body .article-img-link {
  display: block;
  margin: 24px auto;
  text-align: center;
  text-decoration: none;
  cursor: zoom-in;
  border-bottom: none !important;
}

.post-body .article-img-link:hover img {
  opacity: .95;
  box-shadow: 0 4px 16px rgba(0, 0, 0, .08);
}

.post-body .article-img-link img {
  margin: 0 auto;
}

.article-img-caption {
  display: block;
  text-align: center;
  color: var(--portfolio-muted);
  font-family: var(--portfolio-sans, "Inter", sans-serif);
  font-size: 13px;
  line-height: 1.5;
  margin: -14px auto 24px;
}

.abstract {
  background: rgba(255, 255, 255, .28);
  border-left: 3px solid var(--portfolio-blue);
  color: #3f3c36;
  font-family: "Newsreader", Georgia, serif;
  font-size: 17px;
  line-height: 1.72;
  margin: 0 0 2.5em;
  padding: 22px 25px 20px;
}

.abstract-label {
  color: var(--portfolio-blue);
  display: block;
  font-family: "Inter", sans-serif;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .13em;
  margin-bottom: 10px;
  text-transform: uppercase;
}

.portfolio-lang-tag {
  border: 1px solid var(--portfolio-rule);
  border-radius: 99px;
  color: var(--portfolio-muted);
  display: inline-block;
  font-size: 9px;
  letter-spacing: .08em;
  line-height: 1;
  margin-left: 10px;
  padding: 4px 7px;
  vertical-align: middle;
}

.post-meta-item-icon,
.post-meta-item-text {
  color: var(--portfolio-muted);
}

.post-button .btn {
  background: transparent;
  border: 0;
  border-bottom: 2px solid var(--research-blue);
  box-shadow: none;
  color: var(--research-blue);
  font-family: var(--research-sans);
  font-size: 12px;
  font-weight: 900;
  letter-spacing: .065em;
  padding: 7px 1px 5px;
  text-transform: uppercase;
  transition: border-color .16s ease, color .16s ease, transform .16s ease;
}

.post-button .btn:hover,
.post-button .btn:focus {
  background: transparent;
  border-color: var(--research-blue-hover);
  box-shadow: none;
  color: var(--research-blue-hover);
  transform: translateX(2px);
}

.posts-expand .post-eof {
  background: var(--portfolio-rule);
  height: 1px;
  margin: 55px 0;
  width: 100%;
}

.portfolio-discussion {
  background: #eee7da;
  border: 1px solid rgba(23, 23, 20, .2);
  border-top: 2px solid var(--portfolio-blue);
  margin-top: 70px;
  padding: 30px 34px 24px;
}

.portfolio-discussion-header {
  border-bottom: 1px solid rgba(23, 23, 20, .16);
  margin-bottom: 22px;
  padding-bottom: 22px;
}

.portfolio-discussion-title {
  color: var(--portfolio-ink);
  font-family: "Newsreader", "Noto Serif SC", Georgia, serif;
  font-size: 31px;
  font-weight: 600;
  letter-spacing: -.02em;
  line-height: 1.2;
  margin: 0 0 8px;
}

.portfolio-discussion-title > span[aria-hidden] {
  color: var(--portfolio-blue);
  font-weight: 400;
  margin: 0 .12em;
}

.portfolio-discussion-note {
  color: var(--portfolio-muted);
  font-family: "Inter", "Noto Sans SC", sans-serif;
  font-size: 12px;
  letter-spacing: .015em;
  line-height: 1.65;
  margin: 0;
}

.portfolio-discussion .comments {
  margin: 0;
}

.portfolio-discussion .waline-container {
  --waline-theme-color: var(--research-blue);
  --waline-active-color: var(--research-blue-hover);
  --waline-color: var(--research-ink);
  --waline-bg-color: var(--research-paper);
  --waline-bg-color-light: #efe9dd;
  --waline-border-color: var(--research-line);
  --waline-border: 1px solid var(--research-line);
  --waline-info-bg-color: transparent;
  font-family: var(--research-sans);
}

.portfolio-discussion .waline-container a {
  color: var(--research-blue);
}

@media (max-width: 980px) {
  .portfolio-nav {
    gap: 23px;
  }

  .portfolio-writing-row {
    grid-template-columns: minmax(0, 1fr) minmax(230px, .38fr) 18px;
  }
}

@media (max-width: 860px) {
  .portfolio-topics {
    grid-template-columns: 1fr;
  }

  .portfolio-topics a,
  .portfolio-topics a + a {
    border-bottom: 1px solid var(--portfolio-rule);
    border-right: 0;
    padding: 20px 2px;
  }

  .portfolio-topics a:last-child {
    border-bottom: 0;
  }

  .portfolio-writing-row {
    grid-template-columns: minmax(0, 1fr) 14px;
  }

  .portfolio-writing-copy {
    grid-column: 1;
    grid-row: 1;
  }

  body:not(.portfolio-home-page):not(.portfolio-about-page) .main-inner {
    width: calc(100% - 44px);
  }

  body:not(.portfolio-home-page):not(.portfolio-about-page) .post-body {
    font-size: 17px;
    line-height: 1.86;
  }
}

@media (max-width: 520px) {
  .portfolio-nav {
    flex-wrap: wrap;
    gap: 6px 20px;
    justify-content: flex-start;
  }

  .portfolio-nav a {
    font-size: 9px;
  }

  .portfolio-writing-deck {
    font-size: 11px;
  }

  .abstract {
    font-size: 16px;
    margin-left: -8px;
    margin-right: -8px;
    padding: 19px 18px;
  }

  .portfolio-discussion {
    margin-top: 50px;
    padding: 24px 18px 18px;
  }

  .portfolio-discussion-header {
    margin-bottom: 18px;
    padding-bottom: 18px;
  }

  .portfolio-discussion-title {
    font-size: 26px;
  }

  .portfolio-discussion-note {
    font-size: 11px;
  }
}

/* 2026 editorial research homepage. */
:root {
  --research-paper: #f5f1e8;
  --research-ink: #1d1c18;
  --research-muted: #706a60;
  --research-line: #a8a092;
  --research-blue: #2f55d4;
  --research-blue-hover: #2144bd;
  --research-display: "Libre Caslon Display", "Libre Caslon Text", "Songti SC", STSong, SimSun, Georgia, serif;
  --research-serif: "Libre Caslon Text", "Songti SC", STSong, SimSun, Georgia, serif;
  --research-sans: "Lato", "PingFang SC", "Hiragino Sans GB", "Noto Sans CJK SC", Arial, sans-serif;
}

* {
  box-sizing: border-box;
}

body {
  background: var(--research-paper);
  color: var(--research-ink);
  font-family: var(--research-sans);
  -webkit-font-smoothing: antialiased;
}

a:focus-visible,
button:focus-visible {
  outline: 3px solid rgba(47, 85, 212, .42);
  outline-offset: 4px;
}

header.header {
  max-width: 1500px;
  padding: 0 56px;
}

.research-site-header {
  align-items: center;
  border-bottom: 1px solid var(--research-ink);
  display: flex;
  min-height: 94px;
  position: relative;
  width: 100%;
  z-index: 20;
}

.research-brand {
  align-items: center;
  border: 0;
  display: inline-flex;
  flex-shrink: 0;
  gap: 22px;
  text-decoration: none;
}

.research-brand:hover {
  color: var(--research-ink);
}

.research-brand-name {
  font-family: var(--research-display);
  font-size: 34px;
  letter-spacing: -.025em;
  line-height: 1;
}

.research-brand-divider {
  background: var(--research-line);
  height: 38px;
  width: 1px;
}

.research-brand-field {
  font-size: 15px;
  font-weight: 700;
  letter-spacing: .01em;
}

.research-desktop-nav {
  align-items: center;
  align-self: stretch;
  display: flex;
  gap: 44px;
  margin-left: auto;
}

.research-desktop-nav a {
  align-items: center;
  border: 0;
  display: inline-flex;
  font-size: 15px;
  font-weight: 700;
  min-height: 48px;
  position: relative;
  text-decoration: none;
}

.research-desktop-nav a::after {
  background: var(--research-blue);
  bottom: 0;
  content: "";
  height: 2px;
  left: 0;
  opacity: 0;
  position: absolute;
  right: 0;
  transform: scaleX(.45);
  transition: opacity .16s ease, transform .16s ease;
}

.research-desktop-nav a:hover,
.research-desktop-nav a.is-active {
  color: var(--research-blue);
}

.research-desktop-nav a:hover::after,
.research-desktop-nav a.is-active::after {
  opacity: 1;
  transform: scaleX(1);
}

.research-github-link {
  align-items: center;
  border: 0;
  border-left: 1px solid var(--research-line);
  display: inline-flex;
  font-size: 15px;
  font-weight: 700;
  gap: 9px;
  margin-left: 38px;
  padding: 10px 0 10px 38px;
  text-decoration: none;
}

.research-github-link i {
  font-size: 24px;
}

.research-github-link:hover {
  color: var(--research-blue);
}

.research-language-switcher {
  align-items: center;
  display: inline-flex;
  font-size: 12px;
  font-weight: 700;
  gap: 7px;
  letter-spacing: .04em;
  white-space: nowrap;
}

.research-desktop-language {
  margin-left: 25px;
}

.research-language-label {
  color: var(--research-muted);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: .08em;
}

.research-language-switcher a {
  border: 0;
  color: var(--research-muted);
  padding: 6px 0;
  text-decoration: none;
}

.research-language-switcher a:hover,
.research-language-switcher a.is-active {
  color: var(--research-blue);
}

.research-language-switcher a.is-unavailable,
.research-language-switcher a.is-unavailable:hover {
  color: var(--research-line);
  cursor: not-allowed;
  opacity: .65;
}

.research-language-switcher span[aria-hidden="true"] {
  color: var(--research-line);
  font-weight: 400;
}

.research-mobile-language {
  display: none;
}

.research-menu-button,
.research-mobile-nav {
  display: none;
}

.portfolio-home-page .main-inner {
  max-width: 1400px;
  padding: 0 48px;
}

.portfolio-home-page .post-block,
.portfolio-home-page .post-body {
  background: transparent;
  box-shadow: none;
  margin: 0;
  padding: 0;
}

.portfolio-home-page .post-footer {
  display: none;
}

.research-home {
  color: var(--research-ink);
  font-family: var(--research-sans);
}

.research-hero-grid {
  display: grid;
  grid-template-columns: minmax(420px, .9fr) minmax(0, 1.1fr);
  padding: 38px 0 24px;
}

.research-hero-intro {
  display: flex;
  flex-direction: column;
  padding: 0 34px 4px 4px;
}

.research-hero-intro h1,
.research-featured h2,
.research-latest h2,
.research-latest h3 {
  font-family: var(--research-display);
  font-weight: 400;
}

.research-hero-intro h1 {
  font-size: clamp(44px, 3.6vw, 56px);
  letter-spacing: -.035em;
  line-height: 1.06;
  margin: 0;
  max-width: 600px;
  text-align: left;
}

.research-hero-intro > p {
  color: var(--research-muted);
  font-family: var(--research-serif);
  font-size: 17px;
  line-height: 1.45;
  margin: 24px 0 0;
  max-width: 490px;
  text-align: left;
}

.research-hero-actions {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 26px;
  margin-top: 30px;
}

.research-primary-button,
.research-text-button {
  align-items: center;
  display: inline-flex;
  font-size: 14px;
  font-weight: 900;
  justify-content: center;
  letter-spacing: .06em;
  min-height: 56px;
  text-decoration: none;
  text-transform: uppercase;
}

.research-primary-button {
  background: var(--research-blue);
  color: #fff !important;
  min-width: 190px;
  min-height: 52px;
  padding: 0 28px;
  transition: background .16s ease, transform .16s ease;
}

.research-primary-button:hover {
  background: var(--research-blue-hover);
  transform: translateY(-1px);
}

.research-text-button {
  border-bottom: 1px solid var(--research-ink);
  min-height: 44px;
}

.research-text-button:hover {
  border-color: var(--research-blue);
  color: var(--research-blue);
}

.research-featured {
  border-left: 1px solid var(--research-line);
  padding: 0 2px 0 28px;
}

.research-eyebrow {
  color: var(--research-blue);
  font-size: 13px;
  font-weight: 900;
  letter-spacing: .08em;
  margin: 0 0 24px;
  text-transform: uppercase;
}

.research-featured h2 {
  font-size: clamp(32px, 2.7vw, 42px);
  letter-spacing: -.025em;
  line-height: 1.12;
  margin: 0;
}

.research-featured-body {
  display: grid;
  gap: 32px;
  grid-template-columns: minmax(205px, .72fr) minmax(360px, 1.28fr);
  margin-top: 26px;
}

.research-summary {
  display: flex;
  flex-direction: column;
  gap: 25px;
}

.research-summary h3 {
  font-family: var(--research-sans);
  font-size: 16px;
  font-weight: 900;
  margin: 0 0 9px;
}

.research-summary > div > p {
  color: var(--research-muted);
  font-size: 16px;
  line-height: 1.45;
  margin: 0;
  max-width: 270px;
}

.research-meta {
  align-items: center;
  color: var(--research-muted);
  display: flex;
  font-size: 13px;
  gap: 9px;
  margin: 0;
}

.research-meta + .research-meta {
  margin-top: -17px;
}

.research-meta strong {
  color: var(--research-blue);
  font-weight: 900;
}

.research-chart {
  min-width: 0;
  margin: 0;
}

.research-chart figcaption {
  align-items: baseline;
  display: flex;
  font-size: 13px;
  gap: 18px;
  justify-content: space-between;
  margin-bottom: 11px;
}

.research-chart figcaption strong {
  font-size: 15px;
}

.research-chart figcaption span {
  color: var(--research-muted);
  white-space: nowrap;
}

.research-chart img {
  background: #fff;
  border: 1px solid rgba(112, 106, 96, .35);
  display: block;
  height: 276px;
  object-fit: contain;
  width: 100%;
}

.research-featured-actions {
  display: flex;
  gap: 72px;
  margin-top: 26px;
}

.research-featured h2 a {
  border-bottom: 1px solid transparent;
  text-decoration: none;
}

.research-featured h2 a:hover {
  border-color: var(--research-blue);
  color: var(--research-blue);
}

.research-featured-pulse {
  align-self: stretch;
  background: rgba(255, 255, 255, .24);
  border: 1px solid var(--research-line);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 190px;
  padding: 20px;
}

.research-pulse-caption {
  align-items: baseline;
  display: flex;
  font-size: 15px;
  gap: 18px;
  justify-content: space-between;
}

.research-pulse-caption span {
  color: var(--research-muted);
  font-size: 13px;
  white-space: nowrap;
}

.research-featured-pulse p {
  color: var(--research-muted);
  font-family: var(--research-serif);
  font-size: 17px;
  line-height: 1.4;
  margin: 20px 0;
}

.research-featured-pulse img {
  max-height: 72px;
  max-width: 72px;
  object-fit: contain;
}

.research-observatory {
  align-items: center;
  border-bottom: 1px solid var(--research-line);
  border-top: 1px solid var(--research-line);
  display: grid;
  gap: 34px;
  grid-template-columns: minmax(190px, .8fr) minmax(0, 1.45fr) auto;
  padding: 24px 4px;
}

.research-observatory .research-eyebrow {
  margin-bottom: 8px;
}

.research-observatory h2 {
  font-family: var(--research-display);
  font-size: 28px;
  font-weight: 400;
  margin: 0;
}

.research-observatory > p {
  color: var(--research-muted);
  font-family: var(--research-serif);
  font-size: 17px;
  line-height: 1.45;
  margin: 0;
  max-width: 560px;
}

.research-arrow-link {
  align-items: center;
  border: 0;
  border-bottom: 1px solid var(--research-ink);
  display: inline-flex;
  font-size: 13px;
  font-weight: 900;
  gap: 17px;
  letter-spacing: .05em;
  min-height: 42px;
  text-decoration: none;
  text-transform: uppercase;
}

.research-arrow-link:hover {
  border-color: var(--research-blue);
  color: var(--research-blue);
}

.research-arrow-link i {
  font-size: 11px;
  transition: transform .16s ease;
}

.research-arrow-link:hover i {
  transform: translateX(3px);
}

.research-latest {
  border-bottom: 1px solid var(--research-ink);
  border-top: 1px solid var(--research-ink);
  padding: 26px 4px 28px;
}

.research-latest > h2 {
  font-size: 24px;
  margin: 0 0 26px;
}

.research-latest-row {
  align-items: center;
  display: grid;
  gap: 36px;
  grid-template-columns: 180px minmax(360px, 1.24fr) minmax(310px, 1.08fr) auto;
}

.research-latest-meta {
  color: var(--research-muted);
  display: grid;
  font-size: 13px;
  gap: 10px;
}

.research-latest h3 {
  border-left: 1px solid var(--research-line);
  font-size: 23px;
  line-height: 1.2;
  margin: 0;
  padding-left: 40px;
}

.research-latest-row > p {
  color: var(--research-muted);
  font-size: 14px;
  line-height: 1.55;
  margin: 0;
}

.research-profile-strip {
  border-bottom: 1px solid var(--research-line);
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.research-profile-item {
  border: 0;
  color: var(--research-ink);
  display: flex;
  gap: 19px;
  min-width: 0;
  padding: 28px 24px 24px 10px;
  text-decoration: none;
}

.research-profile-item + .research-profile-item {
  border-left: 1px solid var(--research-line);
  padding-left: 38px;
}

.research-profile-item > i {
  font-size: 25px;
  margin-top: 4px;
}

.research-profile-item > span {
  display: grid;
  gap: 5px;
  min-width: 0;
}

.research-profile-item strong {
  font-family: var(--research-serif);
  font-size: 17px;
  font-weight: 400;
}

.research-profile-item small {
  color: var(--research-muted);
  font-size: 12px;
  line-height: 1.45;
}

/* Keep the editorial interface usable when third-party icon fonts are
 * unavailable. These compact glyphs cover the legacy NexT icon classes that
 * remain in generated metadata and utility controls. */
i.fa,
i.fab,
i.far {
  font-family: var(--research-sans);
  font-style: normal;
  line-height: 1;
}

i.fa-arrow-right::before { content: "→"; }
i.fa-external-link-alt::before { content: "↗"; }
i.fa-arrow-up::before { content: "↑"; }
i.fa-angle-left::before { content: "‹"; }
i.fa-angle-right::before { content: "›"; }
i.fa-angle-up::before { content: "⌃"; }
i.fa-angle-down::before { content: "⌄"; }
i.fa-map-marker-alt::before { content: "●"; }
i.fa-chart-line::before { content: "↗"; }
i.fa-book-open::before { content: "▤"; }
i.fa-user::before { content: "●"; }
i.fa-folder::before { content: "▱"; }
i.fa-file-word::before { content: "▤"; }
i.fa-clock::before { content: "◷"; }
i.fa-calendar::before,
i.fa-calendar-check::before { content: "□"; }
i.fa-github::before { content: "GH"; font-size: .72em; font-weight: 900; }

a.research-profile-item:hover strong {
  color: var(--research-blue);
}

.footer {
  max-width: 1500px;
  padding-left: 56px;
  padding-right: 56px;
}

@media (max-width: 1180px) {
  header.header,
  .portfolio-home-page .main-inner,
  .footer {
    padding-left: 38px;
    padding-right: 38px;
  }

  .research-desktop-nav {
    gap: 26px;
  }

  .research-github-link {
    margin-left: 26px;
    padding-left: 26px;
  }

  .research-hero-grid {
    grid-template-columns: minmax(320px, .7fr) minmax(0, 1.3fr);
  }

  .research-featured-body {
    gap: 30px;
    grid-template-columns: minmax(190px, .7fr) minmax(300px, 1.3fr);
  }

  .research-latest-row {
    gap: 28px;
    grid-template-columns: 135px minmax(250px, 1fr) minmax(260px, 1fr) auto;
  }

  .research-profile-item + .research-profile-item {
    padding-left: 24px;
  }
}

@media (max-width: 900px) {
  header.header,
  .portfolio-home-page .main-inner,
  .footer {
    padding-left: 28px;
    padding-right: 28px;
  }

  .research-site-header {
    min-height: 82px;
  }

  .research-brand {
    gap: 14px;
  }

  .research-brand-name {
    font-size: 29px;
  }

  .research-brand-divider {
    height: 31px;
  }

  .research-brand-field {
    font-size: 13px;
  }

  .research-desktop-nav,
  .research-github-link,
  .research-desktop-language {
    display: none;
  }

  .research-menu-button {
    align-items: center;
    background: transparent;
    border: 1px solid var(--research-line);
    display: inline-flex;
    flex-direction: column;
    gap: 5px;
    height: 44px;
    justify-content: center;
    margin-left: auto;
    padding: 0;
    width: 44px;
  }

  .research-menu-button span {
    background: var(--research-ink);
    display: block;
    height: 1px;
    transition: transform .16s ease, opacity .16s ease;
    width: 20px;
  }

  .research-menu-button.is-open span:first-child {
    transform: translateY(6px) rotate(45deg);
  }

  .research-menu-button.is-open span:nth-child(2) {
    opacity: 0;
  }

  .research-menu-button.is-open span:last-child {
    transform: translateY(-6px) rotate(-45deg);
  }

  .research-mobile-nav {
    background: var(--research-paper);
    border-bottom: 1px solid transparent;
    display: grid;
    left: 0;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    position: absolute;
    right: 0;
    top: calc(100% + 1px);
    transition: max-height .2s ease, opacity .18s ease, border-color .18s ease;
  }

  .research-mobile-nav.is-open {
    border-bottom-color: var(--research-ink);
    max-height: 360px;
    opacity: 1;
  }

  .research-mobile-nav a {
    align-items: center;
    border: 0;
    border-bottom: 1px solid rgba(168, 160, 146, .48);
    display: flex;
    font-size: 17px;
    font-weight: 700;
    justify-content: space-between;
    margin: 0 4px;
    min-height: 50px;
    text-decoration: none;
  }

  .research-mobile-language {
    align-items: center;
    border-bottom: 1px solid rgba(168, 160, 146, .48);
    display: flex;
    gap: 20px;
    justify-content: flex-start;
    margin: 0 4px;
    min-height: 50px;
  }

  .research-mobile-language .research-language-label {
    margin-right: auto;
  }

  .research-mobile-language a {
    border-bottom: 0;
    display: inline-flex;
    font-size: 14px;
    margin: 0;
    min-height: auto;
    padding: 8px 0;
  }

  .research-hero-grid {
    grid-template-columns: 1fr;
    padding-top: 46px;
  }

  .research-hero-intro {
    min-height: 530px;
    padding-right: 0;
  }

  .research-featured {
    border-left: 0;
    border-top: 1px solid var(--research-line);
    margin-top: 52px;
    padding: 50px 0 0;
  }

  .research-latest {
    margin-top: 28px;
  }

  .research-observatory {
    align-items: start;
    grid-template-columns: 1fr auto;
  }

  .research-observatory > p {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  .research-latest-row {
    grid-template-columns: 150px 1fr auto;
  }

  .research-latest-row > p {
    grid-column: 2 / -1;
  }

  .research-profile-strip {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .research-profile-item:nth-child(3) {
    border-left: 0;
    border-top: 1px solid var(--research-line);
  }

  .research-profile-item:nth-child(4) {
    border-top: 1px solid var(--research-line);
  }
}

@media (max-width: 650px) {
  header.header,
  .portfolio-home-page .main-inner,
  .footer {
    padding-left: 20px;
    padding-right: 20px;
  }

  .research-brand-field,
  .research-brand-divider {
    display: none;
  }

  .research-hero-intro {
    min-height: 0;
  }

  .research-hero-intro h1 {
    font-size: clamp(44px, 13vw, 58px);
  }

  .research-hero-intro > p {
    font-size: 18px;
    margin-top: 26px;
  }

  .research-hero-actions {
    align-items: flex-start;
    flex-direction: column;
    gap: 14px;
    margin-top: 36px;
  }

  .research-primary-button {
    width: 100%;
  }

  .research-featured {
    margin-top: 44px;
  }

  .research-featured h2 {
    font-size: 42px;
  }

