  .portfolio-home-page .research-featured {
    margin-top: 52px;
    order: 3;
  }

  .portfolio-home-page .research-topics {
    order: 4;
  }

  .portfolio-home-page .research-profile-strip {
    order: 5;
  }

  .research-section-heading {
    align-items: flex-start;
  }

  .research-latest-list .research-latest-row {
    align-items: start;
    gap: 16px;
    grid-template-columns: 1fr;
  }

  .research-latest-list .research-latest-row h3 {
    border-left: 0;
    border-top: 0;
    padding: 0;
  }

  .research-topic-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .research-topic-grid a,
  .research-topic-grid a:first-child {
    border-left: 0;
    border-top: 1px solid var(--research-line);
    min-height: 145px;
    padding: 20px 12px;
  }

  .research-topic-grid a:nth-child(even) {
    border-left: 1px solid var(--research-line);
    padding-left: 24px;
  }

  .portfolio-essays-header {
    padding-top: 39px;
  }

  .portfolio-essay-filters {
    align-items: flex-start;
    flex-direction: column;
  }

  .portfolio-essays-page .post-block {
    padding: 27px 0 25px;
  }

  .portfolio-essays-page .post-title {
    font-size: clamp(27px, 8.7vw, 37px) !important;
  }

  .portfolio-essays-page .post-body > p:first-child {
    font-size: 15px;
    line-height: 1.58;
  }

  .mobile-article-toc {
    background: rgba(255, 255, 255, .28);
    border-bottom: 1px solid var(--research-line);
    border-top: 1px solid var(--research-line);
    display: block;
    font-family: var(--research-sans);
    margin: 27px 0 34px;
    padding: 0;
  }

  .mobile-article-toc summary {
    color: var(--research-ink);
    cursor: pointer;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .07em;
    min-height: 49px;
    padding: 16px 8px;
    text-transform: uppercase;
  }

  .mobile-article-toc ol {
    border-top: 1px solid var(--research-line);
    margin: 0;
    padding: 15px 12px 18px 35px;
  }

  .mobile-article-toc li {
    color: #5e594f;
    font-size: 13px;
    line-height: 1.45;
    margin: 8px 0;
  }

  .mobile-article-toc a {
    color: #403d36;
    text-decoration: none;
  }

  .mobile-article-toc a:hover,
  .mobile-article-toc a:focus-visible {
    color: var(--research-blue);
  }
}

@media (max-width: 600px) {
  .research-section-heading {
    display: grid;
  }

  .research-section-heading > .research-arrow-link {
    justify-self: start;
  }

  .research-topic-grid {
    grid-template-columns: 1fr;
  }

  .research-topic-grid a,
  .research-topic-grid a:first-child,
  .research-topic-grid a:nth-child(even) {
    border-left: 0;
    min-height: 0;
    padding: 20px 4px;
  }

  .portfolio-essays-header h1 {
    font-size: 54px;
  }

  .portfolio-filter-group {
    gap: 6px;
  }

  .portfolio-filter-label {
    flex-basis: 100%;
    margin-bottom: 2px;
  }
}
