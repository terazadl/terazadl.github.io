  background: var(--weekly-japan-bg);
  color: var(--weekly-japan);
}

.weekly-issue-date {
  color: var(--research-muted);
  font-family: var(--research-sans);
  font-size: 12px;
  font-variant-numeric: tabular-nums;
}

.weekly-issue-title {
  font-family: var(--research-display);
  font-size: clamp(19px, 1.6vw, 24px);
  font-weight: 600;
  letter-spacing: -0.02em;
