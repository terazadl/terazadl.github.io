}

.weekly-brief-header-meta {
  align-items: center;
  display: flex;
  gap: 8px;
}

.weekly-issue-card.is-china .weekly-issue-num,
.weekly-brief-card.is-china .weekly-issue-num {
  background: var(--weekly-china-bg);
