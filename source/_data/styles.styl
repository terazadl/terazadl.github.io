  top: 24px;
}

.weekly-scope-label {
  color: var(--research-muted);
  font-family: var(--research-sans);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.12em;
  margin-bottom: 8px;
  text-transform: uppercase;
}

.weekly-scope-title {
  font-family: var(--research-display);
  font-size: 20px;
  font-weight: 600;
  letter-spacing: -0.02em;
  margin: 0 0 14px;
}

.weekly-scope-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: 22px;
}

.weekly-scope-item {
  border-left: 2px solid var(--weekly-card-border);
  padding-left: 12px;
}

.weekly-scope-item-name {
  color: var(--research-blue);
  font-family: var(--research-sans);
  font-size: 12.5px;
  font-weight: 700;
  margin-bottom: 3px;
}

.weekly-scope-item-desc {
  color: var(--research-ink);
  font-family: var(--research-sans);
  font-size: 13px;
  line-height: 1.5;
  margin: 0;
}

.weekly-scope-footer-links {
  border-top: 1px dashed var(--research-line);
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding-top: 16px;
}

@media (max-width: 880px) {
  .weekly-archive-container {
    grid-template-columns: 1fr;
    gap: 24px;
  }
  .weekly-scope-card {
    position: static;
  }
  .weekly-issue-card {
    padding: 20px 18px;
  }
  .weekly-issue-footer {
    flex-direction: column;
    align-items: flex-start;
  }
}

/* --- Politics & Economy Research Hub --- */
.politics-hub-section {
  margin-top: 36px;
