  color: var(--research-muted, #726c5f);
  font-family: var(--research-sans);
  font-size: 13.5px;
  line-height: 1.6;
  margin: 0 0 16px;
}

.politics-stream-articles {
  border-top: 1px dashed rgba(155, 149, 137, 0.25);
  list-style: none;
  margin: 0 0 16px;
  padding: 14px 0 0;
}

.politics-stream-articles li {
  font-family: var(--research-sans);
  font-size: 13px;
  line-height: 1.5;
  margin-bottom: 10px;
  padding-left: 14px;
  position: relative;
}

.politics-stream-articles li::before {
  color: var(--research-muted, #726c5f);
  content: "•";
  font-size: 14px;
  left: 0;
  position: absolute;
  top: -1px;
}

.politics-stream-articles a {
  border-bottom: none !important;
  color: var(--research-ink, #1d1c18);
  text-decoration: none !important;
  transition: color 0.16s ease;
}

.politics-stream-articles a:hover {
  color: var(--research-blue, #2f55d4);
}

.politics-stream-footer {
  border-top: 1px dashed rgba(155, 149, 137, 0.2);
  margin-top: auto;
  padding-top: 12px;
}

.politics-stream-footer .project-link-ghost {
  border-bottom: none !important;
  color: var(--research-muted, #726c5f);
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12.5px;
  font-weight: 600;
  font-family: var(--research-sans);
  text-decoration: none !important;
  transition: color 0.16s ease, transform 0.16s ease;
}

.politics-stream-footer .project-link-ghost:hover {
  color: var(--research-blue, #2f55d4);
  transform: translateX(3px);
}

