/* --- Weekly Archive Magazine Feed --- */
.weekly-archive-container {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(0, 1.05fr);
  gap: 36px;
  margin-top: 36px;
}

.weekly-lang-pills {
  display: flex;
  gap: 8px;
  margin: 24px 0 20px;
  flex-wrap: wrap;
}

.weekly-lang-tab {
  align-items: center;
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid var(--weekly-card-border);
  border-radius: 20px;
  color: var(--research-muted);
  cursor: pointer;
  display: inline-flex;
  font-family: var(--research-sans);
  font-size: 13px;
  font-weight: 500;
  gap: 6px;
  padding: 6px 16px;
  transition: all 0.16s ease;
}

.weekly-lang-tab:hover {
  border-color: var(--research-blue);
  color: var(--research-blue);
}

.weekly-lang-tab.is-active {
  background: var(--research-ink);
  border-color: var(--research-ink);
  color: #ffffff;
  font-weight: 600;
}

.weekly-issue-card {
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid var(--weekly-card-border);
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(29, 28, 24, 0.03);
  display: flex;
  flex-direction: column;
  margin-bottom: 24px;
  padding: 24px 28px 20px;
  position: relative;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.weekly-issue-card:hover {
  box-shadow: 0 6px 20px rgba(29, 28, 24, 0.07);
  transform: translateY(-2px);
}

.weekly-issue-card.is-china {
