}

.weekly-issue-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-bottom: 18px;
}

.weekly-issue-chip {
  background: #ffffff;
  border: 1px solid var(--research-line);
  border-radius: 4px;
  color: var(--research-muted);
