  font-family: var(--research-sans);
  font-size: 12px;
  gap: 6px;
}

.weekly-issue-lang-links a {
  background: rgba(47, 85, 212, 0.06);
  border-radius: 4px;
  color: var(--research-blue);
  font-weight: 600;
  padding: 3px 8px;
