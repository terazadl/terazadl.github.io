<script>
  (() => {
    const path = decodeURIComponent(window.location.pathname);
    let section = "";
    if (path === "/") section = "latest";
    if (
      section !== "latest" &&
      (path.startsWith("/essays/") || path.startsWith("/writing/") || path.startsWith("/archives/") || path.match(/^\/2026\//))
    ) section = "essays";
    if (path.startsWith("/event-radar/")) section = "radar";
    if (path.startsWith("/categories/") || path.startsWith("/tags/")) section = "topics";
    if (path.startsWith("/politics-economy/")) section = "politics";
    if (path.startsWith("/projects/")) section = "projects";
    if (path.startsWith("/life/")) section = "life";
    if (path.startsWith("/about/")) section = "about";
    const current = document.querySelector(`[data-nav-root="${section}"]`);
    if (current) {
      current.classList.add("is-active");
      current.setAttribute("aria-current", "page");
    }
  })();
</script>
