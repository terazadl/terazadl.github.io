<div class="portfolio-site-header">
  <a class="portfolio-brand" href="/" rel="home">
    <span class="portfolio-brand-name">Tera Teng</span>
    <span class="portfolio-brand-divider" aria-hidden="true"></span>
    <span class="portfolio-brand-field">Japan, Money &amp; AI Industry</span>
  </a>
  <nav class="portfolio-nav" aria-label="Primary navigation">
    <a href="/writing/" data-nav-root="writing">Writing</a>
    <a href="/categories/japan/" data-nav-root="japan">Japan</a>
    <a href="/categories/markets/" data-nav-root="markets">Money</a>
    <a href="/categories/ai-industry/" data-nav-root="ai">AI</a>
    <a href="/about/" data-nav-root="about">About</a>
  </nav>
</div>
<script>
  (() => {
    const path = decodeURIComponent(window.location.pathname);
    let section = "";
    if (path === "/" || path.startsWith("/writing/")) section = "writing";
    if (path.startsWith("/categories/japan/")) section = "japan";
    if (path.startsWith("/categories/markets/")) section = "markets";
    if (path.startsWith("/categories/ai-industry/")) section = "ai";
    if (path.startsWith("/about/")) section = "about";
    const current = document.querySelector(`[data-nav-root="${section}"]`);
    if (current) {
      current.classList.add("is-active");
      current.setAttribute("aria-current", "page");
    }
  })();
</script>
